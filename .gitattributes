# ternux — git attributes
# Normalize line endings
* text=auto

# Shell scripts
*.sh text eol=lf

# Documentation
*.md text eol=lf
*.html text eol=lf

# Binary files
*.png binary
*.woff2 binary
*.ico binary

# GitHub assets
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
# Preserve upstream license files byte-for-byte, including terminal blank lines.
lib/licenses/mesa-27.0.0-devel-20261025/licenses/BSL-1.0 -whitespace
lib/licenses/mesa-27.0.0-devel-20261025/licenses/SGI-B-2.0 -whitespace
