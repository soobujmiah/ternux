#!/bin/sh
set -eu

# PRoot does not provide a system polkit service. Run sudo from a terminal so
# its password prompt is visible, then launch Synaptic in the current X11.
exec xfce4-terminal --disable-server --command \
  'sudo -v && exec sudo env DISPLAY="${DISPLAY:-:0}" GTK_THEME=Ternux /usr/sbin/synaptic'
