#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 3 ]; then
  printf 'Usage: %s DISTRO USER_HOME ROOT_HOME\n' "${0##*/}" >&2
  exit 2
fi

distro="$1"
user_home="$2"
root_home="$3"

case "$distro" in
  debian|ubuntu|kali|alpine|archlinux|fedora|opensuse|void|artix|chimera|deepin|manjaro|pardus|rockylinux|adelie) icon="$distro" ;;
  *) printf 'Unsupported managed distro: %s\n' "$distro" >&2; exit 2 ;;
esac

write_bash_prompt() {
  local home="$1" owner="$2" color="$3" rc="$1/.bashrc" tmp
  [ -d "$home" ] || return 0
  [ ! -L "$rc" ] || { printf 'Refusing symlinked shell config: %s\n' "$rc" >&2; return 1; }
  tmp="$(mktemp "$home/.ternux-bashrc.XXXXXX")"
  if [ -f "$rc" ]; then
    awk '
      /^\\n$/ { next }
      /^# TERNUX (DISTRO PROMPT|TERFETCH START|STARTUP AUTH) BEGIN$/ { skip=1; next }
      /^# TERNUX (DISTRO PROMPT|TERFETCH START|STARTUP AUTH) END$/ { skip=0; next }
      !skip { print }
    ' "$rc" > "$tmp"
  fi
  cat >> "$tmp" <<EOF

# TERNUX DISTRO PROMPT BEGIN
if [[ \$- == *i* ]]; then
  PS1='\[\e[1;${color}m\]${owner}@${icon}:\w\\$\[\e[0m\] '
fi
# TERNUX DISTRO PROMPT END

# TERNUX STARTUP AUTH BEGIN
if [[ \$- == *i* ]]; then
  [ -r /dev/tty ] || { printf 'Ternux needs a terminal for startup authentication.\\n' >&2; exit 1; }
  _tnx_auth_file=/run/ternux/startup-password
  if [ ! -r "\$_tnx_auth_file" ]; then printf '\\nTernux startup password is not configured.\\n' >&2; exit 1; fi
  IFS=' ' read -r _tnx_auth_salt _tnx_auth_expected < "\$_tnx_auth_file"
  printf 'Ternux startup password: ' >&2
  IFS= read -r -s _tnx_auth_entered </dev/tty || { printf '\\n' >&2; exit 1; }
  printf '\\n' >&2
  _tnx_auth_actual="\$(printf '%s:%s' "\$_tnx_auth_salt" "\$_tnx_auth_entered" | sha256sum | awk '{print \$1}')"
  unset _tnx_auth_entered
  if [ "\$_tnx_auth_actual" != "\$_tnx_auth_expected" ]; then printf 'Incorrect Ternux startup password.\\n' >&2; exit 1; fi
  unset _tnx_auth_file _tnx_auth_salt _tnx_auth_expected _tnx_auth_actual
fi
# TERNUX STARTUP AUTH END

# TERNUX TERFETCH START BEGIN
# Shell startup files can be sourced more than once by terminal integrations.
if [[ -z \${_TERNUX_TERFETCH_HOOK_LOADED:-} ]]; then
  _TERNUX_TERFETCH_HOOK_LOADED=1
  if [[ \$- == *i* ]] && [[ -z \${TERFETCH_NO_AUTORUN:-} ]] && [[ \${_TERNUX_TERFETCH_AUTORUN_DONE:-0} != 1 ]] && command -v terfetch >/dev/null 2>&1; then
    TERFETCH_STARTUP_ONCE=1 terfetch
    _TERNUX_TERFETCH_AUTORUN_DONE=1
    export _TERNUX_TERFETCH_AUTORUN_DONE
  fi
fi
# TERNUX TERFETCH START END
EOF
  chmod 0644 "$tmp"
  chown "$owner" "$tmp"
  mv -f "$tmp" "$rc"
}

write_zsh_prompt() {
  local home="$1" owner="$2" color="$3" rc="$1/.zshrc" tmp
  [ -d "$home" ] || return 0
  [ ! -L "$rc" ] || { printf 'Refusing symlinked shell config: %s\n' "$rc" >&2; return 1; }
  [ -e "$rc" ] || : > "$rc"
  tmp="$(mktemp "$home/.ternux-zshrc.XXXXXX")"
  awk '
    /^\\n$/ { next }
    /^# TERNUX (DISTRO PROMPT|TERFETCH START|STARTUP AUTH) BEGIN$/ { skip=1; next }
    /^# TERNUX (DISTRO PROMPT|TERFETCH START|STARTUP AUTH) END$/ { skip=0; next }
    !skip { print }
  ' "$rc" > "$tmp"
  cat >> "$tmp" <<EOF

# TERNUX DISTRO PROMPT BEGIN
if [[ -o interactive ]]; then
  PROMPT='%F{${color}}%n@${icon}:%~%#%f '
fi
# TERNUX DISTRO PROMPT END

# TERNUX STARTUP AUTH BEGIN
if [[ -o interactive ]]; then
  [[ -r /dev/tty ]] || { print -u2 'Ternux needs a terminal for startup authentication.'; exit 1; }
  _tnx_auth_file=/run/ternux/startup-password
  if [[ ! -r \$_tnx_auth_file ]]; then print -u2 'Ternux startup password is not configured.'; exit 1; fi
  IFS=' ' read -r _tnx_auth_salt _tnx_auth_expected < \$_tnx_auth_file
  printf 'Ternux startup password: ' >&2
  IFS= read -rs _tnx_auth_entered </dev/tty || { printf '\\n' >&2; exit 1; }
  printf '\\n' >&2
  _tnx_auth_actual="\$(printf '%s:%s' \$_tnx_auth_salt \$_tnx_auth_entered | sha256sum | awk '{print \$1}')"
  unset _tnx_auth_entered
  if [[ \$_tnx_auth_actual != \$_tnx_auth_expected ]]; then print -u2 'Incorrect Ternux startup password.'; exit 1; fi
  unset _tnx_auth_file _tnx_auth_salt _tnx_auth_expected _tnx_auth_actual
fi
# TERNUX STARTUP AUTH END

# TERNUX TERFETCH START BEGIN
# Shell startup files can be sourced more than once by terminal integrations.
if [[ -z \${_TERNUX_TERFETCH_HOOK_LOADED:-} ]]; then
  _TERNUX_TERFETCH_HOOK_LOADED=1
  if [[ \$- == *i* ]] && [[ -z \${TERFETCH_NO_AUTORUN:-} ]] && [[ \${_TERNUX_TERFETCH_AUTORUN_DONE:-0} != 1 ]] && command -v terfetch >/dev/null 2>&1; then
    TERFETCH_STARTUP_ONCE=1 terfetch
    _TERNUX_TERFETCH_AUTORUN_DONE=1
    export _TERNUX_TERFETCH_AUTORUN_DONE
  fi
fi
# TERNUX TERFETCH START END
EOF
  chmod 0644 "$tmp"
  chown "$owner" "$tmp"
  mv -f "$tmp" "$rc"
}

write_alpine_profile() {
  local home="$1" owner="$2" color="$3" rc="$1/.profile" tmp
  [ -d "$home" ] || return 0
  [ ! -L "$rc" ] || { printf 'Refusing symlinked shell config: %s\n' "$rc" >&2; return 1; }
  tmp="$(mktemp "$home/.ternux-profile.XXXXXX")"
  if [ -f "$rc" ]; then
    awk '
      /^\\n$/ { next }
      /^# TERNUX (DISTRO PROMPT|STARTUP AUTH) BEGIN$/ { skip=1; next }
      /^# TERNUX (DISTRO PROMPT|STARTUP AUTH) END$/ { skip=0; next }
      !skip { print }
    ' "$rc" > "$tmp"
  fi
  cat >> "$tmp" <<EOF

# TERNUX DISTRO PROMPT BEGIN
if [ -t 0 ] || [ -r /dev/tty ]; then
  PS1="\$(printf '\\033[1;${color}m')${owner}@${icon}:\\w\\$\$(printf '\\033[0m') "
fi
# TERNUX STARTUP AUTH BEGIN
if [ -t 0 ] || [ -r /dev/tty ]; then
  _tnx_auth_file=/run/ternux/startup-password
  [ -r "\$_tnx_auth_file" ] || { echo 'Ternux startup password is not configured.' >&2; exit 1; }
  read -r _tnx_auth_salt _tnx_auth_expected < "\$_tnx_auth_file"
  printf 'Ternux startup password: ' >&2
  IFS= read -r -s _tnx_auth_entered </dev/tty || { echo >&2; exit 1; }
  echo >&2
  _tnx_auth_actual="\$(printf '%s:%s' "\$_tnx_auth_salt" "\$_tnx_auth_entered" | sha256sum | awk '{print \$1}')"
  unset _tnx_auth_entered
  [ "\$_tnx_auth_actual" = "\$_tnx_auth_expected" ] || { echo 'Incorrect Ternux startup password.' >&2; exit 1; }
  unset _tnx_auth_file _tnx_auth_salt _tnx_auth_expected _tnx_auth_actual
fi
# TERNUX STARTUP AUTH END
if [ -t 0 ] && [ -z "\${TERFETCH_NO_AUTORUN:-}" ] && [ "\${_TERNUX_TERFETCH_AUTORUN_DONE:-0}" != 1 ] && command -v terfetch >/dev/null 2>&1; then
  TERFETCH_STARTUP_ONCE=1 terfetch
  _TERNUX_TERFETCH_AUTORUN_DONE=1
  export _TERNUX_TERFETCH_AUTORUN_DONE
fi
# TERNUX DISTRO PROMPT END
EOF
  chmod 0644 "$tmp"
  chown "$owner" "$tmp"
  mv -f "$tmp" "$rc"
}

configure_terminal_font() {
  local home="$1" owner="$2" config_dir="$1/.config/xfce4/terminal"
  local config_file="$config_dir/terminalrc" tmp
  [ -d "$home" ] || return 0
  [ ! -L "$config_dir" ] && [ ! -L "$config_file" ] || {
    printf 'Refusing symlinked terminal configuration for %s\n' "$home" >&2
    return 1
  }
  install -d -m 0755 -o "$owner" -g "$(id -gn "$owner")" "$config_dir"
  tmp="$(mktemp "$config_dir/.ternux-terminalrc.XXXXXX")"
  if [ -f "$config_file" ]; then
    awk '!/^FontName=|^FontUseSystem=/' "$config_file" > "$tmp"
  else
    printf '[Configuration]\n' > "$tmp"
  fi
  printf 'FontName=Noto Sans Mono 10\nFontUseSystem=FALSE\n' >> "$tmp"
  chmod 0644 "$tmp"
  chown "$owner" "$tmp"
  mv -f "$tmp" "$config_file"
}

for item in "$user_home:$(basename "$user_home"):$distro-user" \
            "$root_home:root:$distro-root"; do
  IFS=: read -r home owner role <<< "$item"
  [ -d "$home" ] || continue
  id "$owner" >/dev/null 2>&1 || { printf 'No guest account for shell home %s\n' "$home" >&2; exit 1; }
  if [ "$distro" = alpine ] && [ "$role" = "$distro-user" ] && [ -x /bin/bash ]; then
    usermod -s /bin/bash "$owner"
  fi
  touch "$home/.hushlogin"
  chown "$owner" "$home/.hushlogin"
  if [ "$role" = "$distro-root" ]; then color=31; else color=36; fi
  write_bash_prompt "$home" "$owner" "$color"
  write_zsh_prompt "$home" "$owner" "$color"
  [ "$distro" != alpine ] || write_alpine_profile "$home" "$owner" "$color"
  configure_terminal_font "$home" "$owner"
done

printf '%s\n' "$distro" > /etc/ternux-distro
chmod 0644 /etc/ternux-distro
