{
  "control": {
    "Package": "ternux",
    "Version": "@VERSION@",
    "Architecture": "all",
    "Maintainer": "Sobuj Miah <soobujmiah@users.noreply.github.com>",
    "Section": "science",
    "Priority": "optional",
    "Depends": "bash, coreutils, grep, sed, gawk, procps, termux-tools",
    "Recommends": "curl, proot-distro",
    "Homepage": "https://github.com/soobujmiah/ternux",
    "Description": [
      "Termux workstation setup and management CLI",
      " Installs and manages a Debian desktop in PRoot on Android.",
      " The package installs the Ternux host CLI only; run `ternux install`",
      " separately to provision the desktop and selected workloads."
    ]
  },
  "installation_prefix": "/data/data/com.termux/files/usr",
  "files_dir": ".",
  "deb_dir": "artifacts/ternux-apt/debs",
  "data_files": {
    "bin/ternux": { "source": "bin/ternux", "perm": "755" },
    "lib/ternux/core.sh": { "source": "lib/core.sh", "perm": "644" },
    "lib/ternux/backend.sh": { "source": "lib/backend.sh", "perm": "644" },
    "lib/ternux/benchmark.sh": { "source": "lib/benchmark.sh", "perm": "644" },
    "lib/ternux/desktop.sh": { "source": "lib/desktop.sh", "perm": "644" },
    "lib/ternux/detect.sh": { "source": "lib/detect.sh", "perm": "644" },
    "lib/ternux/doctor.sh": { "source": "lib/doctor.sh", "perm": "644" },
    "lib/ternux/extension.sh": { "source": "lib/extension.sh", "perm": "644" },
    "lib/ternux/help.sh": { "source": "lib/help.sh", "perm": "644" },
    "lib/ternux/info.sh": { "source": "lib/info.sh", "perm": "644" },
    "lib/ternux/logs.sh": { "source": "lib/logs.sh", "perm": "644" },
    "lib/ternux/profile.sh": { "source": "lib/profile.sh", "perm": "644" },
    "lib/ternux/repair.sh": { "source": "lib/repair.sh", "perm": "644" },
    "lib/ternux/state.sh": { "source": "lib/state.sh", "perm": "644" },
    "lib/ternux/ui.sh": { "source": "lib/ui.sh", "perm": "644" },
    "lib/ternux/phases.sh": { "source": "lib/phases.sh", "perm": "644" },
    "lib/ternux/uninstall.sh": { "source": "lib/uninstall.sh", "perm": "644" },
    "lib/ternux/update.sh": { "source": "lib/update.sh", "perm": "644" },
    "share/doc/ternux/copyright": { "source": "LICENSE", "perm": "644" },
    "share/bash-completion/completions/ternux": { "source": "share/ternux-completion.bash", "perm": "644" }
  }
}
