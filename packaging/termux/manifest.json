{
  "control": {
    "Package": "ternux",
    "Version": "@VERSION@",
    "Architecture": "all",
    "Maintainer": "Sobuj Miah <soobujmiah@users.noreply.github.com>",
    "Section": "science",
    "Priority": "optional",
    "Depends": "bash, coreutils, grep, sed, gawk, procps, termux-tools",
    "Recommends": "curl, proot-distro",
    "Homepage": "https://github.com/soobujmiah/ternux",
    "Description": ["Termux workstation setup and management CLI", " Installs and manages a Debian desktop in PRoot on Android.", " The package installs the Ternux host CLI only; run `ternux install`", " separately to provision the desktop and selected workloads."]
  },
  "installation_prefix": "/data/data/com.termux/files/usr",
  "files_dir": ".",
  "deb_dir": "artifacts/ternux-apt/debs",
  "data_files": {
    "bin/ternux": {"source": "bin/ternux", "perm": "755"},
    "lib/ternux/core.sh": {"source": "lib/core.sh", "perm": "644"},
    "lib/ternux/backend.sh": {"source": "lib/backend.sh", "perm": "644"},
    "lib/ternux/benchmark.sh": {"source": "lib/benchmark.sh", "perm": "644"},
    "lib/ternux/desktop.sh": {"source": "lib/desktop.sh", "perm": "644"},
    "lib/ternux/detect.sh": {"source": "lib/detect.sh", "perm": "644"},
