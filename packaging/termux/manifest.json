    "Package": "ternux",
    "Version": "@VERSION@",
    "Architecture": "all",
    "Maintainer": "Sobuj Miah <soobujmiah@users.noreply.github.com>",
    "Section": "science",
    "Priority": "optional",
    "Depends": "bash, coreutils, grep, sed, gawk, procps, termux-tools",
    "Recommends": "curl, proot-distro",
    "Homepage": "https://github.com/soobujmiah/ternux",
    "Description": [
      "Termux workstation setup and management CLI",
      " Installs and manages a Debian desktop in PRoot on Android.",
      " The package installs the Ternux host CLI only; run `ternux install`",
      " separately to provision the desktop and selected workloads."
    ]
  },
