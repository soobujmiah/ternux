    "lib/ternux/extension.sh": {"source": "lib/extension.sh", "perm": "644"},
    "lib/ternux/help.sh": {"source": "lib/help.sh", "perm": "644"},
    "lib/ternux/info.sh": {"source": "lib/info.sh", "perm": "644"},
    "lib/ternux/logs.sh": {"source": "lib/logs.sh", "perm": "644"},
    "lib/ternux/profile.sh": {"source": "lib/profile.sh", "perm": "644"},
    "lib/ternux/repair.sh": {"source": "lib/repair.sh", "perm": "644"},
    "lib/ternux/state.sh": {"source": "lib/state.sh", "perm": "644"},
    "lib/ternux/ui.sh": {"source": "lib/ui.sh", "perm": "644"},
    "lib/ternux/phases.sh": {"source": "lib/phases.sh", "perm": "644"},
