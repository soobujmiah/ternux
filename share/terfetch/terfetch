#!/usr/bin/env bash
# TERNUX_TERFETCH=1
# Terfetch: a small, dependency-light system summary for Android/Termux/Linux.
set -uo pipefail

TERFETCH_VERSION='0.1.0'

usage() {
  cat <<'EOF'
terfetch - Ternux system summary

Usage: terfetch [--json|--refresh|--version|--help]

Options:
  --json      Print machine-readable JSON
  --refresh   Redraw the display after a terminal resize
  --version   Print the Terfetch version
  --help      Show this help
EOF
}

case "${1:-}" in
  --version|-V) printf 'terfetch %s\n' "$TERFETCH_VERSION"; exit 0 ;;
  --help|-h) usage; exit 0 ;;
  ''|--json|--refresh) ;;
  *) usage >&2; exit 2 ;;
esac

read_prop() {
  command -v getprop >/dev/null 2>&1 && getprop "$1" 2>/dev/null | head -n 1 || true
}

host_termux=0
if [ -n "${PREFIX:-}" ] && [ -x "${PREFIX}/bin/termux-info" ]; then
  host_termux=1
elif command -v getprop >/dev/null 2>&1 && command -v pkg >/dev/null 2>&1; then
  host_termux=1
fi

# Narrow test hooks let CI exercise the native and guest renderers without an
# Android host or an installed proot container.
if [ "${TERFETCH_TEST_HOST:-}" = termux ]; then
  host_termux=1
fi

distro=''
if [ -r /etc/ternux-distro ]; then
  IFS= read -r distro < /etc/ternux-distro || true
fi
if [ -n "${TERFETCH_TEST_DISTRO:-}" ]; then
  distro="$TERFETCH_TEST_DISTRO"
  host_termux=0
fi

if [ -n "$distro" ] && [ -r /etc/os-release ]; then
  . /etc/os-release
  system_name="${PRETTY_NAME:-${NAME:-$distro}}"
  environment='Ternux guest'
elif [ "$host_termux" -eq 1 ]; then
  system_name='Termux'
  distro='termux'
  environment='Android host'
else
  if [ -r /etc/os-release ]; then
    . /etc/os-release
    system_name="${PRETTY_NAME:-${NAME:-Linux}}"
  else
    system_name='Linux'
  fi
  distro='linux'
  environment='Linux host'
fi
if [ -n "${TERFETCH_TEST_DISTRO:-}" ]; then
  distro="$TERFETCH_TEST_DISTRO"
  system_name="$distro (test guest)"
  environment='Ternux guest'
fi

model="$(read_prop ro.product.model)"
manufacturer="$(read_prop ro.product.manufacturer)"
android_release="$(read_prop ro.build.version.release)"
android_sdk="$(read_prop ro.build.version.sdk)"
architecture="$(uname -m 2>/dev/null || printf unknown)"
kernel="$(uname -r 2>/dev/null || printf unknown)"
cpu_model="$(read_prop ro.soc.model)"
[ -n "$cpu_model" ] || cpu_model="$(awk -F ': *' '/^(model name|Hardware|Processor)[[:space:]]*:/ {print $2; exit}' /proc/cpuinfo 2>/dev/null || true)"
[ -n "$cpu_model" ] || cpu_model="$architecture"
gpu_model="$(cat /sys/class/kgsl/kgsl-3d0/gpu_model 2>/dev/null | head -n 1)"
[ -n "$gpu_model" ] || gpu_model="$(read_prop ro.hardware.egl)"
[ -n "$gpu_model" ] || gpu_model='unknown'
cpu_count="$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)"
[ -n "$cpu_count" ] || cpu_count="$(grep -c '^processor[[:space:]]*:' /proc/cpuinfo 2>/dev/null || true)"
[ -n "$cpu_count" ] || cpu_count='?'
memory_values="$(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} END {if (t>0) printf "%.1f GiB / %.1f GiB", (t-a)/1048576, t/1048576}' /proc/meminfo 2>/dev/null || true)"
[ -n "$memory_values" ] || memory_values='unknown'
storage_values="$(df -Pk "$HOME" 2>/dev/null | awk 'NR==2 {printf "%.1f / %.1f GiB", ($3/1048576), ($2/1048576)}')"
[ -n "$storage_values" ] || storage_values='unknown'
storage_free="$(df -Pk "$HOME" 2>/dev/null | awk 'NR==2 {printf "%.1f GiB free", $4/1048576}')"
[ -n "$storage_free" ] || storage_free='unknown'

uptime_value="$(uptime -p 2>/dev/null || true)"
if [ -z "$uptime_value" ]; then
  uptime_value="$(awk '{if ($1>0) {s=int($1); d=int(s/86400); h=int((s%86400)/3600); m=int((s%3600)/60); if (d) printf "up %d days, %d hours, %d mins", d,h,m; else if (h) printf "up %d hours, %d mins",h,m; else printf "up %d mins",m}}' /proc/uptime 2>/dev/null || true)"
fi
[ -n "$uptime_value" ] || uptime_value='unknown'

package_manager=unknown
package_count='unknown'
if command -v dpkg-query >/dev/null 2>&1; then
  package_manager=dpkg
  package_count="$(dpkg-query -W -f='${binary:Package}\n' 2>/dev/null | wc -l | tr -d ' ')"
elif command -v apk >/dev/null 2>&1; then
  package_manager=apk
  package_count="$(apk info 2>/dev/null | wc -l | tr -d ' ')"
elif command -v pacman >/dev/null 2>&1; then
  package_manager=pacman
  package_count="$(pacman -Q 2>/dev/null | wc -l | tr -d ' ')"
elif command -v rpm >/dev/null 2>&1; then
  package_manager=rpm
  package_count="$(rpm -qa 2>/dev/null | wc -l | tr -d ' ')"
elif command -v xbps-query >/dev/null 2>&1; then
  package_manager=xbps
  package_count="$(xbps-query -l 2>/dev/null | wc -l | tr -d ' ')"
fi
packages="$package_count ($package_manager)"

shell_name="${SHELL##*/}"
[ -n "$shell_name" ] || shell_name="$(ps -p "$$" -o comm= 2>/dev/null | tr -d ' ')"
if [ -n "${BASH_VERSION:-}" ]; then shell_name="bash $BASH_VERSION"; fi
if [ -n "${ZSH_VERSION:-}" ]; then shell_name="zsh $ZSH_VERSION"; fi
terminal_name="${TERM_PROGRAM:-${TERM:-unknown}}"
terminal_size="$(stty size 2>/dev/null | awk 'NR==1 {printf "%sx%s", $2, $1}')"
[ -n "$terminal_size" ] || terminal_size='unknown'
display_size=''
if [ -n "${DISPLAY:-}" ] && command -v xdpyinfo >/dev/null 2>&1; then
  display_size="$(xdpyinfo 2>/dev/null | awk '/dimensions:/ {print $2; exit}')"
fi
desktop_name="${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-}}"
[ -n "$desktop_name" ] || { [ "$host_termux" -eq 1 ] && desktop_name='Android'; }
[ -n "$desktop_name" ] || desktop_name='unknown'
battery="$(cat /sys/class/power_supply/battery/capacity 2>/dev/null | head -n 1)"
[ -n "$battery" ] && battery="${battery}%" || battery=''

ternux_version='not detected'
if command -v tx >/dev/null 2>&1; then
  version_output="$(tx --version 2>/dev/null || true)"
  ternux_version="${version_output%%$'\n'*}"
  [ -n "$ternux_version" ] || ternux_version=unknown
elif command -v ternux >/dev/null 2>&1; then
  version_output="$(ternux --version 2>/dev/null || true)"
  ternux_version="${version_output%%$'\n'*}"
  [ -n "$ternux_version" ] || ternux_version=unknown
fi

android='not detected'
if [ "$host_termux" -eq 1 ] || { [ -n "$distro" ] && [ "$distro" != linux ]; }; then
  [ -n "$android_release" ] && android="Android $android_release${android_sdk:+ (SDK $android_sdk)}"
fi

json_escape() {
  sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e ':a;N;$!ba;s/\n/\n/g'
}

if [ "${1:-}" = '--json' ]; then
  printf '{"name":"%s","environment":"%s","distro":"%s","host":"%s","android":"%s","architecture":"%s","cpu_cores":"%s","memory":"%s","storage":"%s","ternux":"%s","kernel":"%s","uptime":"%s","packages":"%s","shell":"%s","terminal":"%s","terminal_size":"%s","display_size":"%s","cpu":"%s","gpu":"%s","desktop":"%s","battery":"%s"}\n' \
    "$(printf '%s' 'Ternux' | json_escape)" \
    "$(printf '%s' "$environment" | json_escape)" \
    "$(printf '%s' "$system_name" | json_escape)" \
    "$(printf '%s' "${manufacturer:+$manufacturer }${model:-unknown device}" | json_escape)" \
    "$(printf '%s' "$android" | json_escape)" \
    "$(printf '%s' "$architecture" | json_escape)" \
    "$(printf '%s' "$cpu_count" | json_escape)" \
    "$(printf '%s' "$memory_values" | json_escape)" \
    "$(printf '%s' "$storage_free" | json_escape)" \
    "$(printf '%s' "$ternux_version" | json_escape)" \
    "$(printf '%s' "$kernel" | json_escape)" \
    "$(printf '%s' "$uptime_value" | json_escape)" \
    "$(printf '%s' "$packages" | json_escape)" \
    "$(printf '%s' "$shell_name" | json_escape)" \
    "$(printf '%s' "$terminal_name" | json_escape)" \
    "$(printf '%s' "$terminal_size" | json_escape)" \
    "$(printf '%s' "$display_size" | json_escape)" \
    "$(printf '%s' "$cpu_model" | json_escape)" \
    "$(printf '%s' "$gpu_model" | json_escape)" \
    "$(printf '%s' "$desktop_name" | json_escape)" \
    "$(printf '%s' "$battery" | json_escape)"
  exit 0
fi

# Prompt hooks call this after a size change. Keep the previous render in
# scrollback so a tall dashboard never loses its monogram or information.

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  c1=$'\033[1;38;5;48m'; c2=$'\033[1;38;5;45m'; c3=$'\033[38;5;109m'; c0=$'\033[0m'
else
  c1=''; c2=''; c3=''; c0=''
fi
terminal_columns="$(stty size 2>/dev/null | awk 'NR==1 {print $2}')"
case "$terminal_columns" in ''|*[!0-9]*) terminal_columns="${COLUMNS:-80}" ;; esac
case "$terminal_columns" in ''|*[!0-9]*) terminal_columns=80 ;; esac
terminal_rows="$(stty size 2>/dev/null | awk 'NR==1 {print $1}')"
case "$terminal_rows" in ''|*[!0-9]*) terminal_rows="${LINES:-24}" ;; esac
case "$terminal_rows" in ''|*[!0-9]*) terminal_rows=24 ;; esac

