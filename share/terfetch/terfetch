logo_credit=''
logo_presented=0
logo_id=linux
if [ "$host_termux" -eq 1 ]; then
  native_logo_ids=(android workstation adelie alpine archlinux artix chimera debian deepin fedora kali manjaro opensuse pardus rockylinux ubuntu void sobuj)
  logo_count="${#native_logo_ids[@]}"
  logo_index="${TERFETCH_LOGO_INDEX:-$((RANDOM % logo_count))}"
  if [[ ! "$logo_index" =~ ^[0-9]+$ ]] || [ "$logo_index" -ge "$logo_count" ]; then
    logo_index=$((RANDOM % logo_count))
  fi
  logo_id="${native_logo_ids[$logo_index]}"
  if [ "$logo_id" = sobuj ]; then
    logo_presented=1
  else
    logo_credit='Presented by @soobujmiah'
  fi
elif [ -n "$distro" ] && [ "$distro" != linux ] && [ "$distro" != termux ]; then
  case "$distro" in rockylinux) logo_id=rocky ;; *) logo_id="$distro" ;; esac
  logo_credit='Presented by @soobujmiah'
fi
set_logo "$logo_id"

# Align the information beside the complete distro logo and center the footer
# across the combined logo and information block.
logo_width=0
for art in "${logo_lines[@]}"; do
  [ "${#art}" -le "$logo_width" ] || logo_width="${#art}"
done
current_user="${USER:-$(id -un 2>/dev/null || printf unknown)}"
locale_name="${LC_ALL:-${LC_CTYPE:-${LANG:-unknown}}}"
init_name="$(cat /proc/1/comm 2>/dev/null | head -n 1)"
if [ -z "$init_name" ]; then
  [ -n "$distro" ] && init_name=proot || init_name=unknown
fi
privilege_name="$(id -u 2>/dev/null || printf unknown)"
[ "$privilege_name" = 0 ] && privilege_name=root || privilege_name=user
labels=('System' 'Distro' 'Environment' 'Kernel' 'Uptime' 'Packages' 'Package manager' 'Architecture' 'CPU' 'CPU cores' 'GPU' 'Memory' 'Storage' 'Shell' 'Terminal' 'Terminal size' 'Ternux' 'User' 'Locale' 'Init' 'Privilege')
values=("$system_name" "$distro" "$environment" "$kernel" "$uptime_value" "$packages" "$package_manager" "$architecture" "$cpu_model" "$cpu_count" "$gpu_model" "$memory_values" "$storage_values ($storage_free)" "$shell_name" "$terminal_name" "$terminal_size" "$ternux_version" "$current_user" "$locale_name" "$init_name" "$privilege_name")
if [ -n "$model" ]; then labels+=(Device); values+=("${manufacturer:+$manufacturer }$model"); fi
if [ "$android" != 'not detected' ]; then labels+=(Android); values+=("$android"); fi
if [ -n "$display_size" ]; then labels+=(Display); values+=("$display_size"); fi
if [ "$desktop_name" != unknown ]; then labels+=(Desktop); values+=("$desktop_name"); fi
if [ -n "$battery" ]; then labels+=(Battery); values+=("$battery"); fi

logo_area_width=$((terminal_columns / 3))
if [ "$logo_area_width" -lt 6 ]; then logo_area_width=6; fi
logo_target_width=$((logo_area_width - 2))
[ "$logo_target_width" -ge 3 ] || logo_target_width=3

# Fit every complete mark into the left third of the live terminal width.
# Resample both axes together so narrow terminal fonts never let the logo
# collide with the information column.
if [ "$logo_width" -gt "$logo_target_width" ]; then
  original_logo_lines=("${logo_lines[@]}")
  original_logo_width="$logo_width"
  original_logo_height="${#original_logo_lines[@]}"
  scaled_logo_height=$(((original_logo_height * logo_target_width + original_logo_width / 2) / original_logo_width))
  [ "$scaled_logo_height" -ge 3 ] || scaled_logo_height=3
  logo_lines=()
  for ((row=0; row<scaled_logo_height; row++)); do
    source_row=$((row * original_logo_height / scaled_logo_height))
    source_line="${original_logo_lines[source_row]}"
    scaled_line=''
    for ((column=0; column<logo_target_width; column++)); do
      source_column=$((column * original_logo_width / logo_target_width))
      glyph="${source_line:source_column:1}"
      scaled_line+="${glyph:- }"
    done
    logo_lines+=("$scaled_line")
  done
  logo_width="$logo_target_width"
fi

info_start=$((logo_area_width + 3))
info_width=$((terminal_columns - info_start))
label_width=$((info_width / 2))
[ "$label_width" -le 15 ] || label_width=15
[ "$label_width" -ge 1 ] || label_width=1
value_width=$((info_width - label_width - 1))
[ "$value_width" -ge 0 ] || value_width=0
# Keep each fact on one physical row. If its complete value cannot fit beside
# the fixed-width label, omit that fact for this render; the resize hook runs
# Terfetch again when the terminal gains columns.
visible_labels=()
visible_values=()
for ((field=0; field<${#labels[@]}; field++)); do
  if [ "${#values[field]}" -le "$value_width" ]; then
    visible_labels+=("${labels[field]}")
    visible_values+=("${values[field]}")
  fi
done
labels=("${visible_labels[@]}")
values=("${visible_values[@]}")
row_count="${#labels[@]}"
block_width="$terminal_columns"
render_rows="$row_count"
[ "$render_rows" -ge "${#logo_lines[@]}" ] || render_rows="${#logo_lines[@]}"
logo_start=$(((render_rows - ${#logo_lines[@]}) / 2))
[ "$logo_start" -ge 0 ] || logo_start=0
logo_pad=$(((logo_area_width - logo_width) / 2))
[ "$logo_pad" -ge 0 ] || logo_pad=0
logo_tail=$((logo_area_width - logo_pad - logo_width))
[ "$logo_tail" -ge 0 ] || logo_tail=0

for ((i=0; i<render_rows; i++)); do
  art=''
  art_color="$c1"
  logo_row=$((i - logo_start))
  if [ "$logo_presented" -eq 1 ] && [ "$i" -eq $((logo_start - 1)) ] && [ "$logo_area_width" -ge 14 ]; then
    art='Presented by'
    art_color="$c3"
  elif [ "$logo_row" -ge 0 ] && [ "$logo_row" -lt "${#logo_lines[@]}" ]; then
    art="${logo_lines[logo_row]}"
  fi
  art_width="$logo_width"
  art_pad=$(((logo_area_width - art_width) / 2))
  [ "$art_pad" -ge 0 ] || art_pad=0
  art_tail=$((logo_area_width - art_pad - art_width))
  [ "$art_tail" -ge 0 ] || art_tail=0
  if [ "$i" -lt "$row_count" ]; then
    printf '  %*s%s%-*s%s%*s %s%-*s%s %s\n' \
      "$art_pad" '' "$art_color" "$art_width" "$art" "$c0" "$art_tail" '' \
      "$c3" "$label_width" "${labels[i]}" "$c0" "${values[i]}"
  else
    printf '  %*s%s%-*s%s%*s\n' \
      "$art_pad" '' "$art_color" "$art_width" "$art" "$c0" "$art_tail" ''
  fi
done

center_plain() {
  local value="$1" color="$2" pad=$(((block_width - ${#1}) / 2))
  [ "$pad" -ge 0 ] || pad=0
  printf '%*s%s%s%s\n' "$pad" '' "$color" "$value" "$c0"
}
center_commands() {
  local -a items=("$@")
  local visible_width=0 pad color item_width
  for item in "${items[@]}"; do visible_width=$((visible_width + 2 + ${#item})); done
  visible_width=$((visible_width + (${#items[@]} - 1) * 7))
  if [ "$visible_width" -gt "$block_width" ]; then
    for item in "${items[@]}"; do
      item_width=$((2 + ${#item}))
      pad=$(((block_width - item_width) / 2))
      [ "$pad" -ge 0 ] || pad=0
      printf '%*s%s$ %s%s\n' "$pad" '' "$c1" "$item" "$c0"
    done
    return
  fi
  pad=$(((block_width - visible_width) / 2))
  [ "$pad" -ge 0 ] || pad=0
  printf '%*s' "$pad" ''
  for ((item_index=0; item_index<${#items[@]}; item_index++)); do
    if [ "$item_index" -gt 0 ]; then printf '   %s|%s   ' "$c3" "$c0"; fi
    color="$c1"
    (( item_index % 2 == 0 )) || color="$c2"
    printf '%s$ %s%s' "$color" "${items[item_index]}" "$c0"
  done
  printf '\n'
}
if [ -n "$logo_credit" ]; then center_plain "$logo_credit" "$c3"; fi
center_plain 'DAILY COMMANDS' "$c3"
if [ "$host_termux" -eq 1 ]; then
  center_commands 'tx guide' 'tx status' 'tx doctor'
  center_commands 'tx start <distro>' 'tx stop --all'
else
  center_commands 'ternux info' 'ternux doctor' 'ternux env'
  case "$distro" in
    alpine|adelie|chimera) center_commands 'sudo apk update' 'sudo apk add <pkg>' ;;
    archlinux|artix|manjaro) center_commands 'sudo pacman -Syu' 'sudo pacman -S <pkg>' ;;
    fedora|rockylinux) center_commands 'sudo dnf check-update' 'sudo dnf install <pkg>' ;;
    opensuse) center_commands 'sudo zypper refresh' 'sudo zypper install <pkg>' ;;
    void) center_commands 'sudo xbps-install -Syu' 'sudo xbps-install <pkg>' ;;
    *) center_commands 'sudo apt update' 'sudo apt install <pkg>' ;;
  esac
fi
