---
const { lang = "en" } = Astro.props;
const bn = lang === "bn";
---

<div class="compute-panel" data-compute-panel>
  <p class="compute-model-line">
    <span>{bn ? "মডেল / কাজ" : "MODEL / WORKLOAD"}</span>
    <strong>
      {bn ? "কিউয়েন ২.৫ · ১.৫বি · কিউ৪_০" : "QWEN2.5 · 1.5B · Q4_0"}
    </strong>
    <i>{bn ? "রেডমি টার্বো ৪ প্রো" : "REDMI TURBO 4 PRO"}</i>
  </p>
  <div
    class="compute-tabs"
    role="tablist"
    aria-label={
      bn
        ? "সিপিইউ, জিপিইউ ও এনপিইউর প্রমাণ বাছুন"
        : "Choose CPU, GPU or NPU evidence"
    }
  >
    <button
      class="compute-tab is-active"
      id="engine-cpu-tab"
      type="button"
      role="tab"
      aria-selected="true"
      aria-controls="engine-cpu"
      data-engine-tab="cpu"
    >
      <span class="engine-dot cpu-dot"></span>
      {bn ? "সিপিইউ" : "CPU"} <small>{bn ? "এআরএম৬৪" : "ARM64"}</small>
    </button>
    <button
      class="compute-tab"
      id="engine-gpu-tab"
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="engine-gpu"
      data-engine-tab="gpu"
      tabindex="-1"
    >
      <span class="engine-dot gpu-dot"></span>
      {bn ? "জিপিইউ" : "GPU"}{" "}
      <small>{bn ? "অ্যাড্রেনো ৮২৫" : "ADRENO 825"}</small>
    </button>
    <button
      class="compute-tab"
      id="engine-htp-tab"
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="engine-htp"
      data-engine-tab="htp"
      tabindex="-1"
    >
      <span class="engine-dot htp-dot"></span>
      {bn ? "এনপিইউ" : "NPU"}{" "}
      <small>{bn ? "হেক্সাগন এইচটিপি" : "HEXAGON HTP"}</small>
    </button>
  </div>

  <section
    class="compute-readout"
    id="engine-cpu"
    role="tabpanel"
    aria-labelledby="engine-cpu-tab"
    data-engine-panel="cpu"
  >
    <header class="compute-readout-head">
      <div>
        <h3>{bn ? "সিপিইউ · এআরএম৬৪" : "CPU · ARM64"}</h3>
      </div>
      <span class="evidence-badge measured">
        <i></i>
        {bn ? "মাপা" : "MEASURED"}
      </span>
    </header>
    <div class="compute-facts">
      <div class="compute-fact">
        <small>{bn ? "সম্পূর্ণ পরীক্ষা" : "TOTAL RUN"}</small>
        <strong>
          264.39 <em>{bn ? "সে." : "s"}</em>
        </strong>
      </div>
      <div class="compute-fact">
        <small>{bn ? "যন্ত্রের অবস্থা" : "DEVICE STATE"}</small>
        <strong>{bn ? "নিষ্ক্রিয়" : "Clean idle"}</strong>
      </div>
    </div>
  </section>

  <section
    class="compute-readout"
    id="engine-gpu"
    role="tabpanel"
    aria-labelledby="engine-gpu-tab"
    data-engine-panel="gpu"
    hidden
  >
    <header class="compute-readout-head">
      <div>
        <h3>{bn ? "অ্যাড্রেনো ৮২৫ · ভলকান" : "Adreno 825 · Vulkan"}</h3>
      </div>
      <span class="evidence-badge verified">
        <i></i>
        {bn ? "যাচাইকৃত" : "VERIFIED"}
      </span>
    </header>
    <div class="compute-facts">
      <div class="compute-fact">
        <small>{bn ? "ভলকান চালকস্তর" : "LAYERS ON VULKAN"}</small>
        <strong>29 / 29</strong>
      </div>
      <div class="compute-fact">
        <small>{bn ? "সঠিকতার যাচাই" : "KNOWN-ANSWER CHECK"}</small>
        <strong>{bn ? "“৪” পাওয়া গেছে" : "Returned “4”"}</strong>
      </div>
    </div>
  </section>

  <section
    class="compute-readout"
    id="engine-htp"
    role="tabpanel"
    aria-labelledby="engine-htp-tab"
    data-engine-panel="htp"
    hidden
  >
    <header class="compute-readout-head">
      <div>
        <h3>{bn ? "হেক্সাগন এইচটিপি · এইচভিএক্স" : "Hexagon HTP · HVX"}</h3>
      </div>
      <span class="evidence-badge experimental">
        <i></i>
        {bn ? "পরীক্ষামূলক" : "EXPERIMENTAL"}
      </span>
    </header>
    <div class="compute-facts">
      <div class="compute-fact">
        <small>{bn ? "সম্পূর্ণ পরীক্ষা" : "TOTAL RUN"}</small>
        <strong>
          129.46 <em>{bn ? "সে." : "s"}</em>
        </strong>
      </div>
      <div class="compute-fact">
        <small>{bn ? "বিন্যাস" : "CONFIGURATION"}</small>
        <strong>
          {bn
            ? "এইচভিএক্স ম্যাটমাল · ফ্ল্যাশ অ্যাটেনশন বন্ধ"
            : "HVX matmul · flash attention off"}
        </strong>
      </div>
      <div class="compute-fact">
        <small>{bn ? "যাচাইয়ের ফল" : "CHECK RESULT"}</small>
        <strong>
          {bn ? "নির্দিষ্ট সীমায় যাচাই পাস" : "Bounded check passed"}
        </strong>
      </div>
    </div>
  </section>

  <div class="compute-chart">
    <header class="compute-chart-head">
      <div>
        <span class="eyebrow">
          {bn ? "একই মডেল · তিন গণনাপথ" : "SAME MODEL · THREE BACKENDS"}
        </span>
        <h3>{bn ? "মাপা গতি" : "Measured speed"}</h3>
      </div>
    </header>
    <div class="compute-chart-grid">
      <div
        class="speed-chart"
        role="img"
        aria-label={
          bn
            ? "টোকেন তৈরি: সিপিইউ ২.৩৮, অ্যাড্রেনো ভলকান ১৩.২৭, পরীক্ষামূলক হেক্সাগন এইচটিপি ১২.০২ টোকেন প্রতি সেকেন্ড"
            : "Token generation: CPU 2.38, Adreno Vulkan 13.27, experimental Hexagon HTP 12.02 tokens per second"
        }
      >
        <h4>
          {bn ? "টোকেন তৈরি" : "TOKEN GENERATION"}
          <small>{bn ? "টোকেন/সে. · মাপ ০–১৪" : "tok/s · SCALE 0–14"}</small>
        </h4>
        <div class="chart-row cpu-row">
          <span>{bn ? "সিপিইউ" : "CPU"}</span>
          <i>
            <b style="--bar:17%"></b>
          </i>
          <strong>2.38</strong>
        </div>
        <div class="chart-row gpu-row">
          <span>{bn ? "অ্যাড্রেনো" : "ADRENO"}</span>
          <i>
            <b style="--bar:95%"></b>
          </i>
          <strong>13.27</strong>
        </div>
        <div class="chart-row htp-row">
          <span>{bn ? "এইচটিপি*" : "HTP*"}</span>
          <i>
            <b style="--bar:86%"></b>
          </i>
          <strong>12.02</strong>
        </div>
      </div>
      <div
        class="speed-chart"
        role="img"
        aria-label={
          bn
            ? "প্রশ্ন প্রক্রিয়াকরণ: সিপিইউ ৫৯.০৪, অ্যাড্রেনো ভলকান ৯২.১৯, পরীক্ষামূলক হেক্সাগন এইচটিপি ৩৪.২০ টোকেন প্রতি সেকেন্ড"
            : "Prompt processing: CPU 59.04, Adreno Vulkan 92.19, experimental Hexagon HTP 34.20 tokens per second"
        }
      >
        <h4>
          {bn ? "প্রশ্ন প্রক্রিয়াকরণ" : "PROMPT PROCESSING"}
          <small>{bn ? "টোকেন/সে. · মাপ ০–১০০" : "tok/s · SCALE 0–100"}</small>
        </h4>
        <div class="chart-row cpu-row">
          <span>{bn ? "সিপিইউ" : "CPU"}</span>
          <i>
            <b style="--bar:59%"></b>
          </i>
          <strong>59.04</strong>
        </div>
        <div class="chart-row gpu-row">
          <span>{bn ? "অ্যাড্রেনো" : "ADRENO"}</span>
          <i>
            <b style="--bar:92%"></b>
          </i>
          <strong>92.19</strong>
        </div>
        <div class="chart-row htp-row">
          <span>{bn ? "এইচটিপি*" : "HTP*"}</span>
          <i>
            <b style="--bar:34%"></b>
          </i>
          <strong>34.20</strong>
        </div>
      </div>
    </div>
    <p class="chart-foot">
      {bn
        ? "প্রতিটি গণনাপথে একবার করে ধারাবাহিক পরীক্ষা। * এইচটিপি পরীক্ষামূলক; এইচভিএক্স ম্যাটমাল ও ফ্ল্যাশ অ্যাটেনশন বন্ধ; এটি সমর্থিত টার্নাক্স পথ নয়।"
        : "One sequential run per backend. * HTP is experimental; HVX matmul and flash attention off; not a supported Ternux route."}
    </p>
  </div>

  <footer class="compute-foot">
    <a
      href={
        bn ? "/ternux/bn/docs/BENCHMARKS.html" : "/ternux/docs/BENCHMARKS.html"
      }
    >
      {bn ? "সম্পূর্ণ মাপজোখ ↗" : "FULL BENCHMARK ↗"}
    </a>
  </footer>
</div>
