---
const { lang = "en" } = Astro.props;
const bn = lang === "bn";
---

<div class="compute-panel" data-compute-panel>
  <p class="compute-model-line">
    <span>{bn ? "মডেল / কাজ" : "MODEL / WORKLOAD"}</span>
    <strong>
      {bn ? "কিউয়েন ২.৫ · ১.৫বি · কিউ৪_০" : "QWEN2.5 · 1.5B · Q4_0"}
    </strong>
    <i>{bn ? "রেডমি টার্বো ৪ প্রো" : "REDMI TURBO 4 PRO"}</i>
  </p>
  <div
    class="compute-tabs"
    role="tablist"
    aria-label={
      bn
        ? "সিপিইউ, জিপিইউ ও এনপিইউর প্রমাণ বাছুন"
        : "Choose CPU, GPU or NPU evidence"
    }
  >
    <button
      class="compute-tab is-active"
      id="engine-cpu-tab"
      type="button"
      role="tab"
      aria-selected="true"
      aria-controls="engine-cpu"
      data-engine-tab="cpu"
    >
      <span class="engine-dot cpu-dot"></span>
      {bn ? "সিপিইউ" : "CPU"} <small>{bn ? "এআরএম৬৪" : "ARM64"}</small>
    </button>
    <button
      class="compute-tab"
      id="engine-gpu-tab"
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="engine-gpu"
      data-engine-tab="gpu"
      tabindex="-1"
    >
      <span class="engine-dot gpu-dot"></span>
      {bn ? "জিপিইউ" : "GPU"}{" "}
      <small>{bn ? "অ্যাড্রেনো ৮২৫" : "ADRENO 825"}</small>
    </button>
    <button
      class="compute-tab"
      id="engine-htp-tab"
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="engine-htp"
      data-engine-tab="htp"
      tabindex="-1"
    >
      <span class="engine-dot htp-dot"></span>
      {bn ? "এনপিইউ" : "NPU"}{" "}
      <small>{bn ? "হেক্সাগন এইচটিপি" : "HEXAGON HTP"}</small>
    </button>
  </div>

  <section
    class="compute-readout"
    id="engine-cpu"
    role="tabpanel"
    aria-labelledby="engine-cpu-tab"
    data-engine-panel="cpu"
  >
    <header class="compute-readout-head">
      <div>
        <h3>{bn ? "সিপিইউ · এআরএম৬৪" : "CPU · ARM64"}</h3>
      </div>
      <span class="evidence-badge measured">
        <i></i>
        {bn ? "মাপা" : "MEASURED"}
      </span>
    </header>
    <div class="compute-facts">
      <div class="compute-fact">
        <small>{bn ? "সম্পূর্ণ পরীক্ষা" : "TOTAL RUN"}</small>
        <strong>
          264.39 <em>{bn ? "সে." : "s"}</em>
        </strong>
      </div>
      <div class="compute-fact">
        <small>{bn ? "যন্ত্রের অবস্থা" : "DEVICE STATE"}</small>
        <strong>{bn ? "নিষ্ক্রিয়" : "Clean idle"}</strong>
      </div>
    </div>
  </section>

  <section
    class="compute-readout"
    id="engine-gpu"
    role="tabpanel"
    aria-labelledby="engine-gpu-tab"
    data-engine-panel="gpu"
    hidden
  >
    <header class="compute-readout-head">
      <div>
        <h3>{bn ? "অ্যাড্রেনো ৮২৫ · ভলকান" : "Adreno 825 · Vulkan"}</h3>
      </div>
      <span class="evidence-badge verified">
        <i></i>
        {bn ? "যাচাইকৃত" : "VERIFIED"}
      </span>
    </header>
    <div class="compute-facts">
      <div class="compute-fact">
        <small>{bn ? "ভলকান চালকস্তর" : "LAYERS ON VULKAN"}</small>
        <strong>29 / 29</strong>
      </div>
      <div class="compute-fact">
        <small>{bn ? "সঠিকতার যাচাই" : "KNOWN-ANSWER CHECK"}</small>
        <strong>{bn ? "“৪” পাওয়া গেছে" : "Returned “4”"}</strong>
      </div>
    </div>
  </section>

  <section
    class="compute-readout"
    id="engine-htp"
    role="tabpanel"
    aria-labelledby="engine-htp-tab"
    data-engine-panel="htp"
    hidden
  >
    <header class="compute-readout-head">
      <div>
        <h3>{bn ? "হেক্সাগন এইচটিপি · এইচভিএক্স" : "Hexagon HTP · HVX"}</h3>
      </div>
      <span class="evidence-badge experimental">
        <i></i>
        {bn ? "পরীক্ষামূলক" : "EXPERIMENTAL"}
      </span>
    </header>
    <div class="compute-facts">
      <div class="compute-fact">
        <small>{bn ? "সম্পূর্ণ পরীক্ষা" : "TOTAL RUN"}</small>
        <strong>
          129.46 <em>{bn ? "সে." : "s"}</em>
        </strong>
      </div>
      <div class="compute-fact">
        <small>{bn ? "বিন্যাস" : "CONFIGURATION"}</small>
        <strong>
          {bn
            ? "এইচভিএক্স ম্যাটমাল · ফ্ল্যাশ অ্যাটেনশন বন্ধ"
            : "HVX matmul · flash attention off"}
        </strong>
      </div>
      <div class="compute-fact">
        <small>{bn ? "যাচাইয়ের ফল" : "CHECK RESULT"}</small>
        <strong>
          {bn ? "নির্দিষ্ট সীমায় যাচাই পাস" : "Bounded check passed"}
        </strong>
      </div>
    </div>
  </section>

  <div class="compute-chart">
    <header class="compute-chart-head">
      <div>
        <span class="eyebrow">
          {bn ? "একই মডেল · তিন গণনাপথ" : "SAME MODEL · THREE BACKENDS"}
        </span>
        <h3>{bn ? "মাপা গতি" : "Measured speed"}</h3>
      </div>
    </header>
    <div class="compute-chart-grid">
      <div
        class="speed-chart"
        role="img"
        aria-label={
          bn
            ? "টোকেন তৈরি: সিপিইউ ২.৩৮, অ্যাড্রেনো ভলকান ১৩.২৭, পরীক্ষামূলক হেক্সাগন এইচটিপি ১২.০২ টোকেন প্রতি সেকেন্ড"
            : "Token generation: CPU 2.38, Adreno Vulkan 13.27, experimental Hexagon HTP 12.02 tokens per second"
        }
      >
        <h4>
          {bn ? "টোকেন তৈরি" : "TOKEN GENERATION"}
          <small>{bn ? "টোকেন/সে. · মাপ ০–১৪" : "tok/s · SCALE 0–14"}</small>
        </h4>
        <div class="chart-row cpu-row">
          <span>{bn ? "সিপিইউ" : "CPU"}</span>
          <i>
            <b style="--bar:17%"></b>
          </i>
          <strong>2.38</strong>
        </div>
        <div class="chart-row gpu-row">
          <span>{bn ? "অ্যাড্রেনো" : "ADRENO"}</span>
          <i>
            <b style="--bar:95%"></b>
          </i>
          <strong>13.27</strong>
        </div>
        <div class="chart-row htp-row">
          <span>{bn ? "এইচটিপি*" : "HTP*"}</span>
          <i>
            <b style="--bar:86%"></b>
          </i>
          <strong>12.02</strong>
        </div>
      </div>
      <div
        class="speed-chart"
        role="img"
        aria-label={
          bn
            ? "প্রশ্ন প্রক্রিয়াকরণ: সিপিইউ ৫৯.০৪, অ্যাড্রেনো ভলকান ৯২.১৯, পরীক্ষামূলক হেক্সাগন এইচটিপি ৩৪.২০ টোকেন প্রতি সেকেন্ড"
            : "Prompt processing: CPU 59.04, Adreno Vulkan 92.19, experimental Hexagon HTP 34.20 tokens per second"
        }
      >
        <h4>
          {bn ? "প্রশ্ন প্রক্রিয়াকরণ" : "PROMPT PROCESSING"}
          <small>{bn ? "টোকেন/সে. · মাপ ০–১০০" : "tok/s · SCALE 0–100"}</small>
        </h4>
        <div class="chart-row cpu-row">
          <span>{bn ? "সিপিইউ" : "CPU"}</span>
          <i>
            <b style="--bar:59%"></b>
          </i>
          <strong>59.04</strong>
        </div>
        <div class="chart-row gpu-row">
          <span>{bn ? "অ্যাড্রেনো" : "ADRENO"}</span>
          <i>
            <b style="--bar:92%"></b>
          </i>
          <strong>92.19</strong>
        </div>
        <div class="chart-row htp-row">
          <span>{bn ? "এইচটিপি*" : "HTP*"}</span>
          <i>
            <b style="--bar:34%"></b>
          </i>
          <strong>34.20</strong>
        </div>
      </div>
    </div>
    <p class="chart-foot">
      {bn
        ? "প্রতিটি গণনাপথে একবার করে ধারাবাহিক পরীক্ষা। * এইচটিপি পরীক্ষামূলক; এইচভিএক্স ম্যাটমাল ও ফ্ল্যাশ অ্যাটেনশন বন্ধ; এটি সমর্থিত টার্নাক্স পথ নয়।"
        : "One sequential run per backend. * HTP is experimental; HVX matmul and flash attention off; not a supported Ternux route."}
    </p>
    <section
      class="matched-bench"
      aria-label={
        bn ? "ছোট মডেলের matched benchmark" : "Matched small-model benchmark"
      }
    >
      <header>
        <div>
          <span class="eyebrow">
            {bn
              ? "Qwen2.5 · 0.5B নামে থাকা GGUF · Q4_0"
              : "QWEN2.5 · 0.5B-NAMED GGUF · Q4_0"}
          </span>
          <h4>
            {bn
              ? "তিনবারের তুলনায় median generation"
              : "Median generation · three runs each"}
          </h4>
        </div>
        <span class="evidence-badge experimental">
          <i></i>
          {bn ? "পরীক্ষামূলক এইচটিপি" : "EXPERIMENTAL HTP"}
        </span>
      </header>
      <div class="matched-bench-values">
        <article class="cpu-row">
          <small>{bn ? "চার-thread CPU" : "4-thread CPU"}</small>
          <strong>
            8.0 <em>tok/s</em>
          </strong>
        </article>
        <article class="gpu-row">
          <small>{bn ? "অ্যাড্রেনো ভলকান" : "Adreno Vulkan"}</small>
          <strong>
            24.8 <em>tok/s</em>
          </strong>
        </article>
        <article class="htp-row">
          <small>{bn ? "হেক্সাগন HTP" : "Hexagon HTP"}</small>
          <strong>
            46.2 <em>tok/s</em>
          </strong>
        </article>
      </div>
      <p>
        {bn
          ? "ফাইলের নামে 0.5B থাকলেও llama.cpp metadata-তে Qwen2 1B ও 630.17M parameter দেখা যায়। একই prompt, settings ও 64-token output রেখে CPU → Vulkan → HTP ক্রমে তিনবার মাপা হয়েছে। এটি এক device-এর স্বল্পমেয়াদি ফল; model quality বা দীর্ঘস্থায়ী performance প্রমাণ করে না।"
          : "GGUF filename says 0.5B; llama.cpp metadata identifies Qwen2 1B with 630.17M parameters. Same prompt/settings and 64-token output; three interleaved CPU → Vulkan → HTP runs. Short single-device throughput only; quality and sustained speed are unqualified."}
      </p>
    </section>
    <section
      class="matched-bench"
      aria-label={
        bn ? "১.৫বি মডেলের matched benchmark" : "Matched 1.5B-model benchmark"
      }
    >
      <header>
        <div>
          <span class="eyebrow">
            {bn ? "কিউয়েন ২.৫ · ১.৫বি · Q4_K_M" : "QWEN2.5 · 1.5B · Q4_K_M"}
          </span>
          <h4>
            {bn
              ? "তিনবারের তুলনায় median generation"
              : "Median generation · three runs each"}
          </h4>
        </div>
        <span class="evidence-badge experimental">
          <i></i>
          {bn ? "পরীক্ষামূলক এইচটিপি" : "EXPERIMENTAL HTP"}
        </span>
      </header>
      <div class="matched-bench-values">
        <article class="cpu-row">
          <small>{bn ? "চার-thread CPU" : "4-thread CPU"}</small>
          <strong>
            7.6 <em>tok/s</em>
          </strong>
        </article>
        <article class="gpu-row">
          <small>{bn ? "অ্যাড্রেনো ভলকান" : "Adreno Vulkan"}</small>
          <strong>
            18.2 <em>tok/s</em>
          </strong>
        </article>
        <article class="htp-row">
          <small>{bn ? "হেক্সাগন HTP" : "Hexagon HTP"}</small>
          <strong>
            18.9 <em>tok/s</em>
          </strong>
        </article>
      </div>
      <p>
        {bn
          ? "একই Qwen2.5 1.5B Q4_K_M model, prompt ও settings, চার thread এবং প্রতিবার 64-token output রেখে CPU → Vulkan → HTP ক্রমে তিনটি round চালানো হয়। নয়টি run-এই উত্তর 4 এসেছে। Median generation: CPU 7.6, Vulkan 18.2, HTP 18.9 tok/s। HTP build আলাদা। এক device-এর এই স্বল্পমেয়াদি পরীক্ষায় HTP Vulkan-এর সামান্য এগিয়ে ছিল; এটি sustained speed বা সাধারণ guarantee নয়।"
          : "Same Qwen2.5 1.5B Q4_K_M model, prompt/settings and four threads; three interleaved runs, with known-answer 4 on each route. HTP was slightly ahead of Vulkan in this short single-device test; no sustained or general performance claim."}
      </p>
    </section>
    <section
      class="matched-bench qnn-bench"
      aria-label={
        bn ? "QNN SD1.5 ব্যাচের মাপজোখ" : "QNN SD1.5 batch measurements"
      }
    >
      <header>
        <div>
          <span class="eyebrow">
            {bn
              ? "QNN · স্টেবল ডিফিউশন ১.৫ · এইচটিপি"
              : "QNN · STABLE DIFFUSION 1.5 · HTP"}
          </span>
          <h4>
            {bn
              ? "দুই ছবির ব্যাচে কম মোট সময়"
              : "Two-image batch · lower total time"}
          </h4>
        </div>
        <span class="evidence-badge experimental">
          <i></i>
          {bn ? "পরীক্ষামূলক" : "EXPERIMENTAL"}
        </span>
      </header>
      <div class="matched-bench-values">
        <article class="qnn-single">
          <small>
            {bn ? "আলাদা একক রান · ২ ছবি" : "Separate singles · 2 images"}
          </small>
          <strong>59.20 <em>s</em></strong>
        </article>
        <article class="qnn-batch">
          <small>{bn ? "এক ব্যাচ · ২ ছবি" : "One batch · 2 images"}</small>
          <strong>46.90 <em>s</em></strong>
        </article>
        <article class="qnn-per-image">
          <small>
            {bn ? "ব্যাচে গড় · প্রতি ছবি" : "Batch average · per image"}
          </small>
          <strong>23.45 <em>s</em></strong>
        </article>
      </div>
      <p>
        {bn
          ? "SM8735-এ QNN SD1.5, ৫১২×৫১২ রেজোলিউশন ও ২০ ধাপ। তিনটি ছোট তুলনামূলক জোড়ায় ব্যাচে মোট সময় ২০.৮% কম ছিল; নমুনা দৈবচয়িত বা বড় ছিল না। একই seed-এ তৈরি ছবিগুলোর hash মিলে গেছে; তবে CLIP/UNet/VAE পর্যায়ের tensor ফল স্বাধীনভাবে যাচাই হয়নি। ৩–৫ সেকেন্ডের লক্ষ্য পূরণ হয়নি; এই ফল উৎপাদন-ব্যবহারের গতির নিশ্চয়তা নয়."
          : "QNN SD1.5, 512×512 at 20 steps on SM8735. Across three small paired runs, batching lowered total time by 20.8%; the sample was neither randomized nor large. Same-seed image hashes matched, but independent CLIP/UNet/VAE tensor correctness is unverified. The 3–5 second target remains unmet; this is not a production performance claim."}
      </p>
    </section>
  </div>

  <footer class="compute-foot">
    <a
      href={
        bn ? "/ternux/bn/docs/BENCHMARKS.html" : "/ternux/docs/BENCHMARKS.html"
      }
    >
      {bn ? "সম্পূর্ণ মাপজোখ ↗" : "FULL BENCHMARK ↗"}
    </a>
  </footer>
</div>
