---
import MeshGlyph from "./MeshGlyph.astro";

const { lang = "en" } = Astro.props;
const bn = lang === "bn";
---

<div
  class="render-timeline"
  aria-label={
    bn
      ? "এমপিএফবি২ চরিত্র তৈরি ও ব্লেন্ডার রেন্ডারের মাপা কাজের ধারা"
      : "Measured MPFB2 character creation and Blender rendering workflow"
  }
>
  <div class="timeline-beam" aria-hidden="true"></div>
  <article class="render-stage" data-reveal>
    <span class="render-orb mesh-orb" aria-hidden="true">
      <MeshGlyph />
    </span>
    <small>{bn ? "০১ / তৈরি" : "01 / GENERATE"}</small>
    <h3>{bn ? "প্রাথমিক মেশ" : "Base mesh"}</h3>
    <strong>
      {bn ? "০.৪" : "0.4"} <em>{bn ? "সে." : "s"}</em>
    </strong>
    <p>{bn ? "১৯,১৫৮টি শীর্ষবিন্দু" : "19,158 vertices"}</p>
  </article>
  <article class="render-stage" data-reveal>
    <span class="render-orb build-orb" aria-hidden="true">
      <MeshGlyph />
    </span>
    <small>{bn ? "০২ / গঠন" : "02 / ASSEMBLE"}</small>
    <h3>{bn ? "চরিত্র গঠন" : "Character build"}</h3>
    <strong>
      {bn ? "৩.৯" : "3.9"} <em>{bn ? "সে." : "s"}</em>
    </strong>
    <p>{bn ? "মেশ · ত্বক · উপকরণ · কাঠামো" : "mesh · skin · assets · rig"}</p>
  </article>
  <article class="render-stage" data-reveal>
    <span class="render-orb still-orb" aria-hidden="true">
      <MeshGlyph />
    </span>
    <small>{bn ? "০৩ / স্থিরচিত্র" : "03 / STILL"}</small>
    <h3>{bn ? "স্থির ছবি" : "Still image"}</h3>
    <strong>
      {bn ? "প্রায় ৪" : "~4"} <em>{bn ? "সে." : "s"}</em>
    </strong>
    <p>{bn ? "৪৬০ × ৮০০ · ইভি নেক্সট" : "460 × 800 · EEVEE Next"}</p>
  </article>
  <article class="render-stage" data-reveal>
    <span class="render-orb frame-orb" aria-hidden="true">
      <MeshGlyph />
    </span>
    <small>{bn ? "০৪ / চলমান দৃশ্য" : "04 / ANIMATE"}</small>
    <h3>{bn ? "অ্যানিমেশনের ফ্রেম" : "Animation frame"}</h3>
    <strong>
      {bn ? "৩.৮" : "3.8"} <em>{bn ? "সে." : "s"}</em>
    </strong>
    <p>{bn ? "৫৪০ × ৯৬০ · ইভি নেক্সট" : "540 × 960 · EEVEE Next"}</p>
  </article>
  <article class="render-stage render-finale" data-reveal>
    <span class="render-orb movie-orb" aria-hidden="true">
      <MeshGlyph />
    </span>
    <small>{bn ? "০৫ / দৃশ্যক্রম" : "05 / SEQUENCE"}</small>
    <h3>{bn ? "৫ সেকেন্ডের দৃশ্য" : "Five-second shot"}</h3>
    <strong>
      {bn ? "প্রায় ৭.৫" : "~7.5"} <em>{bn ? "মিনিট" : "min"}</em>
    </strong>
    <p>{bn ? "১২০টি ফ্রেম · সেকেন্ডে ২৪ ফ্রেম" : "120 frames · 24 fps"}</p>
  </article>
</div>
