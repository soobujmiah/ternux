---
const { lang = "en" } = Astro.props;
const bn = lang === "bn";
---

<div
  class="system-visual"
  data-tilt
  role="img"
  aria-label={
    bn
      ? "অ্যান্ড্রয়েড ফোনের ভেতরে টার্মাক্স, ডেবিয়ান, এডিটি এবং অ্যাড্রেনো জিপিইউ-সহ টার্নাক্স ওয়ার্কস্টেশনের চিত্র"
      : "Ternux workstation diagram: an Android phone running Termux, Debian, ADT and Adreno GPU workloads"
  }
>
  <div class="orbit orbit-one" aria-hidden="true"></div>
  <div class="orbit orbit-two" aria-hidden="true"></div>
  <div class="orbit orbit-three" aria-hidden="true"></div>
  <div class="device-platform" aria-hidden="true"></div>

  <div class="signal-chip chip-cpu" aria-hidden="true">
    <span class="chip-mark cpu-mark">{bn ? "সি" : "C"}</span>
    <span>
      <b>{bn ? "সিপিইউ" : "CPU"}</b>
      <small>{bn ? "এআরএম৬৪ · লামা.সিপিপি" : "ARM64 · llama.cpp"}</small>
    </span>
    <i></i>
  </div>
  <div class="signal-chip chip-gpu" aria-hidden="true">
    <span class="chip-mark gpu-mark">{bn ? "জি" : "G"}</span>
    <span>
      <b>{bn ? "অ্যাড্রেনো ৮২৫" : "ADRENO 825"}</b>
      <small>{bn ? "ভলকান · জিঙ্ক" : "VULKAN · ZINK"}</small>
    </span>
    <i></i>
  </div>
  <div class="signal-chip chip-htp" aria-hidden="true">
    <span class="chip-mark htp-mark">{bn ? "হে" : "H"}</span>
    <span>
      <b>{bn ? "হেক্সাগন এইচটিপি" : "HEXAGON HTP"}</b>
      <small>{bn ? "পরীক্ষামূলক" : "EXPERIMENTAL"}</small>
    </span>
    <i></i>
  </div>

  <div class="phone-3d" aria-hidden="true">
    <div class="phone-back"></div>
    <div class="phone-side"></div>
    <div class="phone-front">
      <div class="phone-camera"></div>
      <div class="phone-screen">
        <div class="phone-status">
          <span>{bn ? "স্থানীয়" : "LOCAL"}</span>
          <span>{bn ? "এআরএম৬৪" : "ARM64"}</span>
          <span>{bn ? "প্রস্তুত" : "READY"}</span>
        </div>
        <div class="screen-brand">
          <span>&gt;_</span> {bn ? "টার্নাক্স" : "TERNUX"}{" "}
          <i>{bn ? "ডেবিয়ান ওয়ার্কস্টেশন" : "DEBIAN WORKSTATION"}</i>
        </div>
        <div class="terminal-window">
          <div class="terminal-title">
            <i></i>
            <i></i>
            <i></i>
            <span>{bn ? "ডেবিয়ান — জেডশ" : "debian — zsh"}</span>
          </div>
          <code>
            <span>{bn ? "সবুজ@রেডমি" : "sbj@redmi"}</span>:~${" "}
            {bn ? "ফাস্টফেচ" : "fastfetch"}
          </code>
          <div class="terminal-rule"></div>
          <div class="terminal-info">
            <b>{bn ? "ডেবিয়ান ১৩" : "Debian 13"}</b>
            <small>{bn ? "প্রুট · এআরএম৬৪" : "PRoot · aarch64"}</small>
          </div>
          <div class="terminal-info">
            <b>{bn ? "এক্সএফসিই ৪" : "XFCE 4"}</b>
            <small>{bn ? "টার্মাক্স:এক্স১১" : "Termux:X11"}</small>
          </div>
          <div class="terminal-info">
            <b>{bn ? "এডিটি নির্মাণ-সরঞ্জাম" : "ADT toolchain"}</b>
            <small>
              {bn ? "অ্যান্ড্রয়েড এসডিকে · এনডিকে" : "Android SDK · NDK"}
            </small>
          </div>
          <div class="terminal-prompt">
            <span>●</span> {bn ? "ব্যবস্থা প্রস্তুত" : "system ready"}
          </div>
        </div>
        <div class="screen-dock">
          <span>⌘</span>
          <span>▤</span>
          <span>◉</span>
          <span>▦</span>
        </div>
      </div>
    </div>
  </div>

  <div class="visual-caption">
    <span class="live-dot"></span>
    <span>
      {bn
        ? "একটি ফোন · সম্পূর্ণ এআরএম৬৪ ওয়ার্কস্টেশন"
        : "ONE PHONE · FULL ARM64 WORKSTATION"}
    </span>
  </div>
</div>
