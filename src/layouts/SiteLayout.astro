---
import "../styles/site.css";
import { baseUrl } from "../lib/content";
const {
  title,
  description,
  lang = "en",
  canonical = "/",
  altUrl,
  article = false,
  noIndex = false,
} = Astro.props;
const canonicalUrl = new URL(baseUrl(canonical), "https://soobujmiah.github.io")
  .href;
const englishUrl =
  lang === "bn"
    ? new URL(baseUrl(altUrl || "/"), "https://soobujmiah.github.io").href
    : canonicalUrl;
const bengaliUrl =
  lang === "bn"
    ? canonicalUrl
    : altUrl
      ? new URL(baseUrl(altUrl), "https://soobujmiah.github.io").href
      : "";
const titleText = `${title} · ${lang === "bn" ? "টার্নাক্স" : "Ternux"}`;
const matrixFallback = (lang === "bn" ? "টার্নাক্স" : "TERNUX").repeat(8);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <meta name="theme-color" content="#070d09" />
    <meta name="color-scheme" content="dark" />
    <title>{titleText}</title>
    <meta name="description" content={description} />
    <meta name="author" content={lang === "bn" ? "সবুজ মিয়া" : "Sobuj Miah"} />
    <meta
      name="robots"
      content={
        noIndex ? "noindex,follow" : "index,follow,max-image-preview:large"
      }
    />
    <link rel="canonical" href={canonicalUrl} />
    {englishUrl && <link rel="alternate" hreflang="en" href={englishUrl} />}
    {bengaliUrl && <link rel="alternate" hreflang="bn" href={bengaliUrl} />}
    {englishUrl && (
      <link rel="alternate" hreflang="x-default" href={englishUrl} />
    )}
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta
      property="og:site_name"
      content={lang === "bn" ? "টার্নাক্স" : "Ternux"}
    />
    <meta property="og:title" content={titleText} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta
      property="og:image"
      content="https://soobujmiah.github.io/ternux/assets/img/og-card.png"
    />
    <meta
      property="og:image:alt"
      content={
        lang === "bn"
          ? "অ্যান্ড্রয়েড ফোনে চলা টার্নাক্স ডেবিয়ান লিনাক্স ওয়ার্কস্টেশন"
          : "Ternux Debian Linux workstation running on an Android phone"
      }
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "bn" ? "bn_BD" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titleText} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://soobujmiah.github.io/ternux/assets/img/og-card.png"
    />
    <meta
      name="twitter:image:alt"
      content={
        lang === "bn"
          ? "অ্যান্ড্রয়েড ফোনে চলা টার্নাক্স ডেবিয়ান লিনাক্স ওয়ার্কস্টেশন"
          : "Ternux Debian Linux workstation running on an Android phone"
      }
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23070d09'/%3E%3Cpath d='M14 18l14 14-14 14M34 46h16' fill='none' stroke='%238bf5a6' stroke-width='7' stroke-linecap='round'/%3E%3C/svg%3E"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": article ? "TechArticle" : "SoftwareApplication",
        name: title,
        headline: title,
        description,
        inLanguage: lang,
        url: canonicalUrl,
        isPartOf: {
          "@type": "WebSite",
          name: lang === "bn" ? "টার্নাক্স" : "Ternux",
          url: "https://soobujmiah.github.io/ternux/",
        },
        author: {
          "@type": "Person",
          name: lang === "bn" ? "সবুজ মিয়া" : "Sobuj Miah",
          url: "https://soobujmiah.github.io/",
        },
        codeRepository: "https://github.com/soobujmiah/ternux",
        license: "https://www.apache.org/licenses/LICENSE-2.0",
      })}
    ></script>
  </head>
  <body class:list={[`lang-${lang}`, { "article-page": article }]}>
    <div class="matrix-field" aria-hidden="true">
      {Array.from({ length: 8 }, () => (
        <span>{matrixFallback}</span>
      ))}
    </div>
    <a class="skip" href="#main">
      {lang === "bn" ? "মূল বিষয়বস্তুতে যান" : "Skip to content"}
    </a>
    <header class="topbar">
      <span class="read-progress" aria-hidden="true"></span>
      <a class="brand" href={baseUrl(lang === "bn" ? "/bn/" : "/")}>
        <span class="brand-mark">
          &gt;<i>_</i>
        </span>
        <b>
          {lang === "bn" ? (
            "টার্নাক্স"
          ) : (
            <>
              TERN<span>UX</span>
            </>
          )}
        </b>
        <small>
          {lang === "bn"
            ? "এআরএম৬৪ / ফোনেই লিনাক্স"
            : "ARM64 / ON-DEVICE LINUX"}
        </small>
      </a>
      <nav
        class="toplinks"
        aria-label={lang === "bn" ? "প্রধান নেভিগেশন" : "Primary navigation"}
      >
        <a
          class="install-nav-link"
          href={baseUrl(lang === "bn" ? "/bn/" : "/") + "#install"}
        >
          {lang === "bn" ? "ইনস্টল" : "Install"}
        </a>
        <a href={baseUrl(lang === "bn" ? "/bn/docs/" : "/docs/")}>
          {lang === "bn" ? "নথি" : "Docs"}
        </a>
        <a
          href={baseUrl(
            lang === "bn"
              ? "/bn/docs/BENCHMARKS.html"
              : "/docs/BENCHMARKS.html",
          )}
        >
          {lang === "bn" ? "প্রমাণ" : "Evidence"}
        </a>
        <a class="portfolio-link" href="https://soobujmiah.github.io/">
          {lang === "bn" ? "পোর্টফোলিও ↗" : "Portfolio ↗"}
        </a>
        <a href="https://github.com/soobujmiah/ternux">
          {lang === "bn" ? "গিটহাব ↗" : "GitHub ↗"}
        </a>
        {altUrl && (
          <a
            class="lang-switch"
            href={baseUrl(altUrl)}
            hreflang={lang === "bn" ? "en" : "bn"}
          >
            {lang === "bn" ? "ইংরেজি" : "বাংলা"}
          </a>
        )}
      </nav>
      <div class="mobile-controls">
        {altUrl && (
          <a
            class="mobile-language"
            href={baseUrl(altUrl)}
            hreflang={lang === "bn" ? "en" : "bn"}
          >
            {lang === "bn" ? "ইংরেজি" : "বাংলা"}
          </a>
        )}
        <details class="mobile-nav">
          <summary>
            {lang === "bn" ? "মেনু" : "MENU"}
            <span aria-hidden="true">+</span>
          </summary>
          <nav
            aria-label={lang === "bn" ? "মোবাইল নেভিগেশন" : "Mobile navigation"}
          >
            <a href={baseUrl(lang === "bn" ? "/bn/" : "/")}>
              {lang === "bn" ? "হোম" : "Home"}
            </a>
            <a href={baseUrl(lang === "bn" ? "/bn/" : "/") + "#install"}>
              {lang === "bn" ? "ইনস্টলেশন" : "Install options"}
            </a>
            <a href={baseUrl(lang === "bn" ? "/bn/docs/" : "/docs/")}>
              {lang === "bn" ? "নথি" : "Docs"}
            </a>
            <a
              href={baseUrl(
                lang === "bn"
                  ? "/bn/docs/BENCHMARKS.html"
                  : "/docs/BENCHMARKS.html",
              )}
            >
              {lang === "bn" ? "প্রমাণ" : "Evidence"}
            </a>
            <a href="https://soobujmiah.github.io/">
              {lang === "bn" ? "পোর্টফোলিও ↗" : "Portfolio ↗"}
            </a>
            <a href="https://github.com/soobujmiah/ternux">
              {lang === "bn" ? "গিটহাব ↗" : "GitHub ↗"}
            </a>
          </nav>
        </details>
      </div>
    </header>
    <slot />
    <footer class="footer">
      <span>{lang === "bn" ? "© ২০২৬ সবুজ মিয়া" : "© 2026 Sobuj Miah"}</span>
      <a
        class="footer-evidence"
        href={baseUrl(
          lang === "bn" ? "/bn/docs/BENCHMARKS.html" : "/docs/BENCHMARKS.html",
        )}
      >
        {lang === "bn"
          ? "প্রমাণভিত্তিক লিনাক্স · মাপজোখ ↗"
          : "Evidence-led Linux · benchmarks ↗"}
      </a>
    </footer>
    <script>
      const reducedMotion = matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      document.body.classList.add("js-reveal");
      const progressBar = document.querySelector(".read-progress");
      const updateProgress = () => {
        if (!progressBar) return;
        const scrollable = document.documentElement.scrollHeight - innerHeight;
        progressBar.style.transform = `scaleX(${scrollable > 0 ? scrollY / scrollable : 0})`;
      };
      addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();
      const revealItems = document.querySelectorAll("[data-reveal]");
      if (reducedMotion || !("IntersectionObserver" in window)) {
        revealItems.forEach((item) => item.classList.add("visible"));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -48px 0px", threshold: 0.08 },
        );
        revealItems.forEach((item) => revealObserver.observe(item));
      }

      const copyText = async (text) => {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return;
        }
        const field = document.createElement("textarea");
        field.value = text;
        field.setAttribute("readonly", "");
        field.style.position = "fixed";
        field.style.opacity = "0";
        document.body.append(field);
        field.select();
        const copied = document.execCommand("copy");
        field.remove();
        if (!copied) throw new Error("Clipboard copy unavailable");
      };
      const isBangla = document.documentElement.lang === "bn";
      const wireCopy = (button, code, label) => {
        if (!code) return;
        button.addEventListener("click", async () => {
          try {
            await copyText(button.dataset.copyValue || code.textContent || "");
            button.textContent = isBangla ? "কপি হয়েছে" : "COPIED";
            button.setAttribute(
              "aria-label",
              isBangla ? "কমান্ড কপি হয়েছে" : "Copied to clipboard",
            );
          } catch {
            button.textContent = isBangla ? "কপি হয়নি" : "COPY FAILED";
            button.setAttribute(
              "aria-label",
              isBangla
                ? "কপি হয়নি; নির্দেশনা নির্বাচন করে কপি করুন"
                : "Copy failed; select the code manually",
            );
          }
          setTimeout(() => {
            button.textContent = label;
            button.setAttribute(
              "aria-label",
              isBangla ? "কমান্ড কপি করুন" : "Copy code to clipboard",
            );
          }, 1800);
        });
      };
      document
        .querySelectorAll(".command [data-copy]")
        .forEach((button) =>
          wireCopy(
            button,
            button.closest(".command")?.querySelector("code"),
            button.textContent?.trim() || "COPY",
          ),
        );
      document.querySelectorAll(".article pre").forEach((pre) => {
        const code = pre.querySelector("code");
        if (!code || pre.querySelector(".copy-code")) return;
        const button = document.createElement("button");
        button.className = "copy-code";
        button.type = "button";
        button.textContent = "COPY";
        button.setAttribute("aria-label", "Copy code to clipboard");
        pre.append(button);
        wireCopy(button, code, "COPY");
      });

      document.querySelectorAll("[data-compute-panel]").forEach((group) => {
        const tabs = [...group.querySelectorAll("[data-engine-tab]")];
        const panels = [...group.querySelectorAll("[data-engine-panel]")];
        const activate = (tab, focus = false) => {
          tabs.forEach((item) => {
            const active = item === tab;
            item.classList.toggle("is-active", active);
            item.setAttribute("aria-selected", String(active));
            item.tabIndex = active ? 0 : -1;
          });
          panels.forEach((panel) => {
            panel.hidden = panel.dataset.enginePanel !== tab.dataset.engineTab;
          });
          if (focus) tab.focus();
        };
        tabs.forEach((tab, index) => {
          tab.addEventListener("click", () => activate(tab));
          tab.addEventListener("keydown", (event) => {
            if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key))
              return;
            event.preventDefault();
            const next =
              event.key === "Home"
                ? 0
                : event.key === "End"
                  ? tabs.length - 1
                  : (index +
                      (event.key === "ArrowRight" ? 1 : tabs.length - 1)) %
                    tabs.length;
            activate(tabs[next], true);
          });
        });
      });

      const mobileNav = document.querySelector(".mobile-nav");
      mobileNav
        ?.querySelectorAll("a")
        .forEach((link) =>
          link.addEventListener("click", () => (mobileNav.open = false)),
        );
      document.addEventListener("pointerdown", (event) => {
        if (mobileNav?.open && !mobileNav.contains(event.target))
          mobileNav.open = false;
      });
      const mobileSidebar = matchMedia("(max-width: 760px)");
      const setSidebarState = () =>
        document.querySelectorAll(".sidebar details").forEach((details) => {
          details.open = !mobileSidebar.matches;
        });
      setSidebarState();
      mobileSidebar.addEventListener?.("change", setSidebarState);
    </script>
  </body>
</html>
