---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { allPages, pageUrl, baseUrl } from "../../../lib/content";
import { nav } from "../../../data/navigation";
export function getStaticPaths() {
  return allPages("bn")
    .filter((page) => !page.route.endsWith("/index.md"))
    .map((page) => ({
      params: { slug: page.route.split("/").pop()!.replace(/\.md$/, "") },
      props: { page },
    }));
}
const { page } = Astro.props;
const path = pageUrl(page);
---

<SiteLayout
  title={page.title}
  description={page.description}
  lang="bn"
  canonical={path.replace("/ternux", "")}
  altUrl={page.alt_url}
  article={true}
  noIndex={page.route.endsWith("ACCELERATOR-RELEASE-PLAN.md")}
>
  <div class="article-shell">
    <aside class="sidebar">
      <details open>
        <summary>ডকুমেন্টেশন নেভিগেশন</summary>
        <nav>
          {nav.bn.map((group) => (
            <section>
              <h2>{group.label}</h2>
              <ul>
                {group.items.map(([label, href]) => (
                  <li>
                    <a
                      href={baseUrl(href)}
                      aria-current={
                        baseUrl(href.replace(/\/$/, "/index.html")) === path
                          ? "page"
                          : undefined
                      }
                    >
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </nav>
      </details>
    </aside>
    <main class="article" id="main">
      <div class="crumb">
        <a href={baseUrl("/bn/")}>হোম</a>　/　
        <a href={baseUrl("/bn/docs/")}>ডকস</a>　/　{page.title}
      </div>
      <h1>{page.title}</h1>
      <p class="description">{page.description}</p>
      <article set:html={page.html} />
    </main>
    <aside class="toc">
      <b>এই পৃষ্ঠায়</b>
      <nav data-toc></nav>
    </aside>
  </div>
  <footer class="doc-footer">
    ভুল বা নতুন device evidence?{" "}
    <a href="https://github.com/soobujmiah/ternux/issues/new/choose">
      ইস্যু খুলুন ↗
    </a>
  </footer>
  <script>
    const toc = document.querySelector("[data-toc]");
    document.querySelectorAll(".article h2,.article h3").forEach((h) => {
      if (!h.id || !toc) return;
      const a = document.createElement("a");
      a.href = `#${h.id}`;
      a.textContent = h.textContent || "";
      toc.append(a);
    });
  </script>
</SiteLayout>
