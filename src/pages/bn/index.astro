---
import SiteLayout from "../../layouts/SiteLayout.astro";
import WorkstationDiagram from "../../components/WorkstationDiagram.astro";
import ComputeBench from "../../components/ComputeBench.astro";
import RenderBench from "../../components/RenderBench.astro";

const installCommand = `pkg update -y && pkg upgrade -y && pkg install -y curl wget && bash -c 's=$(mktemp) && (curl -fsSL https://raw.githubusercontent.com/soobujmiah/ternux/c2a008cc4e6dc038fdf324f5128e2205e8a1583a/install.sh -o "$s" || wget -qO "$s" https://raw.githubusercontent.com/soobujmiah/ternux/c2a008cc4e6dc038fdf324f5128e2205e8a1583a/install.sh) && bash "$s"; r=$?; rm -f "$s"; exit "$r"'`;
---

<SiteLayout
  title="অ্যান্ড্রয়েড লিনাক্স ওয়ার্কস্টেশন ও লোকাল AI ল্যাব | Ternux"
  description="রুট ছাড়াই Android ফোনে Linux workstation ও computing lab তৈরি করুন। Ternux-এ Debian, GPU rendering, CPU/Vulkan local LLM, Stable Diffusion preview, Blender এবং Android development tools ব্যবহার ও পরীক্ষা করুন।"
  lang="bn"
  canonical="/bn/"
  altUrl="/"
>
  <main id="main">
    <section class="home-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">অ্যান্ড্রয়েড × লিনাক্স · এআরএম৬৪</span>
          <h1 aria-label="রুট ছাড়া অ্যান্ড্রয়েডে লিনাক্স ডেস্কটপ">
            <span class="matrix-title" data-matrix-title aria-hidden="true">
              <span class="matrix-title-text">লিনাক্স</span>
            </span>
            <br />
            <em class="hero-tagline" aria-hidden="true">
              মোবাইল লিনাক্স ওয়ার্কস্টেশন
            </em>
            <span class="hero-signature">রুট ছাড়া · এআরএম৬৪</span>
          </h1>
          <p>
            Android ফোনকে রুট ছাড়াই ARM64 Linux workstation ও on-device
            computing lab হিসেবে ব্যবহার করুন। Ternux-এ Debian, Ubuntu, Kali
            Linux ও Alpine ডেস্কটপ, Android app development, Adreno GPU-তে
            Blender rendering এবং CPU/Vulkan-ভিত্তিক local AI ও LLM inference
            পরীক্ষা করা যায়। Stable Diffusion image generation preview
            পর্যায়ে; Hexagon HTP ও QNN পরীক্ষামূলক। ফলাফল নির্দিষ্ট যন্ত্রের
            পরীক্ষার ওপর নির্ভরশীল—সব ফোনে একই কর্মক্ষমতার নিশ্চয়তা নয়।
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#install">
              Ternux ইনস্টল করুন <span>↓</span>
            </a>
            <a class="button" href="/ternux/bn/docs/ARCHITECTURE.html">
              কাজের ধরন জানুন <span>→</span>
            </a>
          </div>
          <div class="hero-label">
            রুটের দরকার নেই　/　উন্মুক্ত উৎস　/　প্রমাণভিত্তিক
          </div>
        </div>
        <div
          class="hero-system-route"
          aria-label="টার্নাক্সের ব্যবস্থাপথ: অ্যান্ড্রয়েড, Termux, PRoot অতিথি পরিবেশ, Termux:X11"
        >
          <span class="route-heading">ব্যবস্থাপথ / প্রস্তুত</span>
          <span>
            অ্যান্ড্রয়েড <b>মূল যন্ত্র</b>
          </span>
          <span>
            Termux <b>কমান্ডের পরিবেশ</b>
          </span>
          <span>
            PRoot <b>Debian · Ubuntu · Kali · Alpine</b>
          </span>
          <span>
            Termux:X11 <b>পর্দা · অডিও</b>
          </span>
        </div>
      </div>
    </section>
    <section class="section" id="supported-guests" data-reveal>
      <div class="container">
        <div class="device-panel profile-panel">
          <div class="device-copy">
            <span class="eyebrow">০১ / v2-তে সমর্থিত ডেস্কটপ পরিবেশ</span>
            <h2>পছন্দের লিনাক্স পরিবেশ বেছে নিন।</h2>
            <p>
              এই চারটি পরিবেশ v2-তে যাচাইকৃত। Debian প্রস্তাবিত; বাকি ১১টি
              রেসিপি ব্যবহারযোগ্য হলেও যাচাইকৃত পরিধিতে নেই।
            </p>
          </div>
          <div class="profile-grid">
            <article class="profile-card is-recommended">
              <small>প্রস্তাবিত ডিফল্ট</small>
              <strong>Debian</strong>
              <span>এক্সএফসিই · APT · Avro</span>
            </article>
            <article class="profile-card">
              <small>সমর্থিত পরিবেশ</small>
              <strong>Ubuntu</strong>
              <span>এক্সএফসিই · APT · snap-সহনীয়</span>
            </article>
            <article class="profile-card">
              <small>সমর্থিত পরিবেশ</small>
              <strong>Kali Linux</strong>
              <span>এক্সএফসিই · APT · নিরাপত্তা সরঞ্জাম</span>
            </article>
            <article class="profile-card">
              <small>সমর্থিত পরিবেশ</small>
              <strong>Alpine</strong>
              <span>এক্সএফসিই · APK · Avro m17n</span>
            </article>
          </div>
        </div>
      </div>
    </section>
    <section class="section" id="system-map" data-reveal>
      <div class="container">
        <header class="section-head">
          <span class="eyebrow">০২ / ব্যবস্থার মানচিত্র</span>
          <div>
            <h2>
              একটি যন্ত্র।
              <br />
              স্তরে সাজানো ওয়ার্কস্টেশন।
            </h2>
            <p>
              প্রতিটি অংশের কাজ নির্দিষ্ট। Ternux মূল যন্ত্র, লিনাক্সের পরিবেশ,
              পর্দা ও গ্রাফিক্সের পথকে একটি যাচাইযোগ্য ব্যবস্থায় সাজায়।
            </p>
          </div>
        </header>
        <div
          class="architecture"
          aria-label="অ্যান্ড্রয়েড থেকে লিনাক্স ও জিপিইউ ব্যবস্থার প্রবাহ"
        >
          <article class="arch-stage" data-index="০১ / মূল যন্ত্র">
            <span class="arch-pulse"></span>
            <h3>অ্যান্ড্রয়েড</h3>
            <p>ফোনের যন্ত্রাংশ ও কার্নেল</p>
          </article>
          <article class="arch-stage" data-index="০২ / কমান্ড পরিবেশ">
            <span class="arch-pulse"></span>
            <h3>টার্মাক্স</h3>
            <p>এআরএম৬৪-এর নিজস্ব সরঞ্জাম</p>
          </article>
          <article class="arch-stage" data-index="০৩ / লিনাক্স">
            <span class="arch-pulse"></span>
            <h3>PRoot · ১৫টি প্রোফাইল</h3>
            <p>আলাদা অতিথি পরিবেশ · এক্সএফসিই</p>
          </article>
          <article class="arch-stage" data-index="০৪ / পর্দা">
            <span class="arch-pulse"></span>
            <h3>Termux:X11</h3>
            <p>অ্যান্ড্রয়েড এক্স সার্ভার · আলাদা অতিথি-জানালা</p>
          </article>
          <article class="arch-stage" data-index="০৫ / জিপিইউ">
            <span class="arch-pulse"></span>
            <h3>Zink · Turnip</h3>
            <p>
              Adreno 825-এ ইনস্টল করা চারটি প্রোফাইল পরীক্ষা; প্রমাণ নির্দিষ্ট
              যন্ত্রে সীমাবদ্ধ
            </p>
          </article>
          <article class="arch-stage" data-index="০৬ / প্রস্তুত">
            <span class="arch-pulse"></span>
            <h3>Ternux</h3>
            <p>এক ফোনেই সম্পূর্ণ ওয়ার্কস্টেশন</p>
          </article>
        </div>
        <div class="system-device">
          <WorkstationDiagram lang="bn" />
        </div>
      </div>
    </section>
    <section class="section" id="install" data-reveal>
      <div class="container">
        <div class="install-panel">
          <div>
            <span class="eyebrow">০৩ / প্রথমবার চালু</span>
            <h2>লিনাক্স ওয়ার্কস্টেশন চালু করুন।</h2>
            <p>
              Termux ও Termux:X11 একই উৎস থেকে ইনস্টল করুন, যাতে দুই অ্যাপের
              স্বাক্ষর মেলে। Termux:X11 একবার খুলে নিন। এরপর সহজ পদ্ধতিতে নিচের
              একটিমাত্র কমান্ড কপি করে Termux-এ চালান। প্রতিটি ধাপ নিজে করতে
              চাইলে আলাদা ধাপভিত্তিক নির্দেশিকা বেছে নিন। GitHub থেকে নেওয়া
              Termux-এর ক্ষেত্রে সামনে চালু থাকা X11-এর জন্য{" "}
              <a href="https://github.com/termux/termux-x11/releases/tag/nightly">
                Termux:X11 ভাগ-করা UID পরীক্ষামূলক APK
              </a>
              নেওয়া যায়; F-Droid বা Google Play-এর Termux হলে একই পাতার সাধারণ
              সর্বজনীন পরীক্ষামূলক APK ব্যবহার করুন।
            </p>
            <p
              class="install-links"
              aria-label="Termux ও সহায়ক অ্যাপ নামানোর লিংক"
            >
              <a href="https://f-droid.org/packages/com.termux/">
                Termux · F-Droid ↗
              </a>
              <a href="https://github.com/termux/termux-app/releases">
                Termux · GitHub ↗
              </a>
              <a href="https://github.com/termux/termux-api/releases">
                Termux:API · GitHub ↗
              </a>
              <a href="https://f-droid.org/packages/com.termux.api/">
                Termux:API · F-Droid ↗
              </a>
              <a href="https://github.com/termux/termux-boot/releases">
                Termux:Boot · GitHub ↗
              </a>
              <a href="https://f-droid.org/packages/com.termux.boot/">
                Termux:Boot · F-Droid ↗
              </a>
              <a href="https://github.com/termux/termux-styling/releases">
                Termux:Styling · GitHub ↗
              </a>
              <a href="https://f-droid.org/packages/com.termux.styling/">
                Termux:Styling · F-Droid ↗
              </a>
              <a href="https://github.com/termux/termux-x11/releases/tag/nightly">
                Termux:X11 · APK ↗
              </a>
            </p>
            <a
              class="home-section-link"
              href="/ternux/bn/docs/INSTALLATION.html"
            >
              ইনস্টলেশনের নির্দেশিকা ↗
            </a>
            <a class="home-section-link" href="/ternux/bn/docs/MANUAL.html">
              হাতে-কলমে ধাপে ধাপে ইনস্টল ↗
            </a>
            <a
              class="home-section-link"
              href="/ternux/bn/docs/QUICK-START.html"
            >
              দ্রুত শুরু করুন ↗
            </a>
            <p>
              v2.0.0 GitHub রিলিজ ও স্থিতিশীল APT বিতরণ ২০২৬-১১-১৪ তারিখে
              প্রত্যাহার করা হয়েছে; উৎস ট্যাগটি প্রমাণ ও ইতিহাসের জন্য রাখা
              হয়েছে। নিচের উৎস-ইনস্টলার ব্যবহার করুন; <code>/apt-rc</code>
              কেবল ইচ্ছাকৃত পরীক্ষামূলক সংস্করণ যাচাইয়ের জন্য। Termux:API
              ব্যবহার করতে Termux-এর ভিতরে একই সংস্করণের
              <code>termux-api</code> প্যাকেজও লাগবে।
            </p>
          </div>
          <div class="command">
            <span class="command-kicker">TERMUX · এক কমান্ডে ইনস্টল</span>
            <small>নিরাপদ প্রাথমিক স্থাপন · curl না চললে wget</small>
            <button type="button" data-copy data-copy-value={installCommand}>
              কপি
            </button>
            <code>{installCommand}</code>
          </div>
          <p class="install-note">
            কমান্ডটি Termux-এর প্যাকেজ তালিকা হালনাগাদ করে, প্যাকেজ উন্নীত করে,
            এরপর <code>curl</code> ও <code>wget</code> বসায়। প্রথম ডাউনলোডার
            ব্যর্থ হলে দ্বিতীয়টি দিয়ে ইনস্টলার নামায়; সফলভাবে নামার পরেই
            চালায়। স্থাপন মাঝপথে থামলে কমান্ডটি আবার চালালে ইনস্টলেশন অসম্পূর্ণ
            ধাপ থেকে চলতে পারে। <code>pkg</code> বা <code>curl</code>
            চালুই না হলে আগে সমস্যার সমাধানের নির্দেশিকা পড়ুন। স্থিতিশীল APT
            চ্যানেল বন্ধ, তাই <code>pkg install ternux</code> এখন পাওয়া যায়
            না;
            <a href="/ternux/bn/docs/TERMUX-APT.html">
              বর্তমান চ্যানেলের অবস্থা দেখুন ↗
            </a>
            ।
          </p>
        </div>
      </div>
    </section>
    <section class="section" id="project-status" data-reveal>
      <div class="container">
        <div class="device-panel profile-panel status-panel">
          <div class="device-copy">
            <span class="eyebrow">প্রকল্পের অবস্থা · ২০ নভেম্বর ২০২৬</span>
            <h2>v2.0.0 প্রত্যাহৃত। v2.0.1-এর সোর্স রিলিজ প্রকাশিত।</h2>
            <p>
              v2.0.0 GitHub রিলিজ ও স্থিতিশীল APT বিতরণ ২০২৬-১১-১৪ তারিখে
              প্রত্যাহার করা হয়েছে; ইতিহাস যাচাইয়ের জন্য উৎস ট্যাগটি রাখা
              হয়েছে। Debian, Ubuntu, Kali Linux ও Alpine—এই চারটি ডেস্কটপ
              পরিবেশ v2-তে সমর্থিত; আরও ১১টি নামযুক্ত ডিস্ট্রো রেসিপি নথিভুক্ত,
              তবে যাচাইকৃত নয়—মোট ১৫টি প্রোফাইল। প্রতিটির যাচাইয়ের মাত্রা
              আলাদা। বর্তমান মূল
              উৎসে কেবল-পাঠযোগ্য চারটি ব্যবস্থাপক সিএলআই কমান্ড, সামনে চলা
              ইউনিক্স সকেট পরিষেবা এবং নিশ্চিতকরণসহ ডেস্কটপ চালু-বন্ধ করার `tx
              control` পূর্বরূপ আছে; এর জন্য ঐচ্ছিক পাইথন ৩ লাগে। v2.0.1
              যাচাইকৃত ট্যাগ থেকে সোর্স আর্কাইভ হিসেবে প্রকাশিত। নির্দিষ্ট
              সংস্করণের{" "}
              <a href="/ternux/bn/docs/release/pages/v2.0.1-INSTALLATION.html">
                ইনস্টলেশন নির্দেশিকা
              </a>{" "}
              দেখুন। পূর্ণ পরিষেবা-তদারকি, ড্যাশবোর্ডের বাকি অংশ এবং নতুন v3
              কাঠামো ভবিষ্যৎ কাজ; স্থিতিশীল APT এখনো বন্ধ।
            </p>
          </div>
          <div class="profile-grid">
            <a
              class="profile-card"
              href="/ternux/bn/docs/V2-RELEASE-READINESS.html"
            >
              <small>v2 বিতরণের অবস্থা</small>
              <strong>v2.0.1 প্রকাশিত</strong>
              <span>প্রকাশনার নথি দেখুন ↗</span>
            </a>
            <a class="profile-card" href="/ternux/bn/docs/V3-ARCHITECTURE.html">
              <small>প্রকল্পের কর্মপরিকল্পনা</small>
              <strong>v3-এর ভবিষ্যৎ কাজ</strong>
              <span>বর্তমান অবস্থা ও পরবর্তী ধাপ ↗</span>
            </a>
            <a class="profile-card" href="https://github.com/soobujmiah/ternux">
              <small>উৎসভান্ডার</small>
              <strong>main</strong>
              <span>উৎস, সমস্যা ও পরিবর্তন ↗</span>
            </a>
