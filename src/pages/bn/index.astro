---
import SiteLayout from "../../layouts/SiteLayout.astro";
import WorkstationDiagram from "../../components/WorkstationDiagram.astro";
import ComputeBench from "../../components/ComputeBench.astro";
import RenderBench from "../../components/RenderBench.astro";
---

<SiteLayout
  title="পকেটেই লিনাক্স ওয়ার্কস্টেশন"
  description="Android ARM64 ফোনে no-root Debian workstation. Termux, PRoot, Xfce এবং evidence-led Adreno GPU acceleration."
  lang="bn"
  canonical="/bn/"
  altUrl="/"
>
  <main id="main">
    <section class="home-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">ANDROID × DEBIAN · ARM64</span>
          <h1 aria-label="লিনাক্স ওয়ার্কস্টেশন আপনার পকেটে">
            <span class="matrix-title" data-matrix-title aria-hidden="true">
              <span class="matrix-title-text">লিনাক্স</span>
            </span>
            <br />
            <em aria-hidden="true">ওয়ার্কস্টেশন আপনার পকেটে</em>
          </h1>
          <p>
            Android ফোনেই সম্পূর্ণ ARM64 Linux workstation। Root বা remote
            server দরকার নেই। সতর্কভাবে তৈরি stack-টি ফোনকে build, render ও
            compute করার বাস্তব পরিবেশে রূপ দেয়।
          </p>
          <div class="hero-actions">
            <a class="button primary" href="/ternux/bn/docs/QUICK-START.html">
              WORKSTATION চালু করুন <span>↗</span>
            </a>
            <a class="button" href="/ternux/bn/docs/ARCHITECTURE.html">
              STACK দেখুন <span>→</span>
            </a>
          </div>
          <div class="hero-label">
            ROOT লাগবে না　/　OPEN SOURCE　/　EVIDENCE LED
          </div>
        </div>
        <div class="hero-system-route" aria-label="Ternux system route">
          <span>
            ANDROID <b>HOST</b>
          </span>
          <span>
            TERMUX <b>SHELL</b>
          </span>
          <span>
            DEBIAN <b>GUEST</b>
          </span>
          <span>
            ADRENO <b>GRAPHICS</b>
          </span>
        </div>
      </div>
    </section>
    <section class="section" id="device-profile" data-reveal>
      <div class="container">
        <div class="device-panel">
          <div class="device-copy">
            <span class="eyebrow">01 / HOST DEVICE</span>
            <h2>Redmi Turbo 4 Pro</h2>
            <p>
              গল্প শুরু হচ্ছে নিচের measurement-এর জন্য ব্যবহৃত যাচাইকৃত Android
              ফোন থেকে। ফলাফল এই configured device-এর জন্যই প্রযোজ্য।
            </p>
          </div>
          <div class="device-data">
            <div>
              <small>System on chip</small>
              <strong>Snapdragon 8s Gen 4</strong>
            </div>
            <div>
              <small>Graphics</small>
              <strong>Adreno 825</strong>
            </div>
            <div>
              <small>Host OS</small>
              <strong>Android</strong>
            </div>
            <div>
              <small>Architecture</small>
              <strong>ARM64</strong>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="section" id="system-map" data-reveal>
      <div class="container">
        <header class="section-head">
          <span class="eyebrow">02 / SYSTEM MAP</span>
          <div>
            <h2>
              একটি ডিভাইস।
              <br />
              স্তরে সাজানো workstation.
            </h2>
            <p>
              প্রতিটি অংশের কাজ নির্দিষ্ট। Ternux host, Linux environment,
              display ও graphics route-কে এক যাচাইযোগ্য system-এ সাজায়।
            </p>
          </div>
        </header>
        <div
          class="architecture"
          aria-label="Android থেকে Linux ও GPU system flow"
        >
          <article class="arch-stage" data-index="01 / HOST">
            <span class="arch-pulse"></span>
            <h3>Android</h3>
            <p>ফোন hardware ও kernel</p>
          </article>
          <article class="arch-stage" data-index="02 / SHELL">
            <span class="arch-pulse"></span>
            <h3>Termux</h3>
            <p>Native ARM64 tools</p>
          </article>
          <article class="arch-stage" data-index="03 / LINUX">
            <span class="arch-pulse"></span>
            <h3>PRoot · Debian</h3>
            <p>Linux userspace · Xfce</p>
          </article>
          <article class="arch-stage" data-index="04 / DISPLAY">
            <span class="arch-pulse"></span>
            <h3>Termux:X11</h3>
            <p>Android display bridge</p>
          </article>
          <article class="arch-stage" data-index="05 / GPU">
            <span class="arch-pulse"></span>
            <h3>Zink · Turnip</h3>
            <p>Vulkan-এর উপর OpenGL</p>
          </article>
          <article class="arch-stage" data-index="06 / READY">
            <span class="arch-pulse"></span>
            <h3>Ternux</h3>
            <p>এক ফোনে সম্পূর্ণ workstation</p>
          </article>
        </div>
        <div class="system-device">
          <WorkstationDiagram lang="bn" />
        </div>
      </div>
    </section>
    <section class="section" id="install" data-reveal>
      <div class="container">
        <div class="install-panel">
          <div>
            <span class="eyebrow">03 / FIRST BOOT</span>
            <h2>Linux workstation চালু করুন।</h2>
            <p>
              বিশ্বস্ত source থেকে Termux install করে quick-start অনুসরণ করুন।
              Setup স্পষ্ট, inspect করা যায় এবং ফোনের বাস্তব সীমা মাথায় রেখে
              তৈরি।
            </p>
            <a
              class="home-section-link"
              href="/ternux/bn/docs/INSTALLATION.html"
            >
              INSTALLATION guide ↗
            </a>
          </div>
          <div class="command">
            <small>TERMUX / SHELL</small>
            <button type="button" data-copy>
              COPY
            </button>
            <code>
              curl -fsSL
              https://raw.githubusercontent.com/soobujmiah/ternux/main/install.sh
              | bash
            </code>
          </div>
        </div>
      </div>
    </section>
    <section
      class="section ecosystem-section"
      id="android-development"
      data-reveal
    >
      <div class="container">
        <div class="ecosystem-panel">
          <div class="ecosystem-graphic" aria-hidden="true">
            <span class="ecosystem-node ecosystem-ternux">
              TERN
              <br />
              UX
            </span>
            <span class="ecosystem-link"></span>
            <span class="ecosystem-node ecosystem-adt">ADT</span>
            <span class="ecosystem-caption">ONE DEVICE · TWO TOOLSETS</span>
          </div>
          <div class="ecosystem-copy">
            <span class="eyebrow">04 / ANDROID DEVELOPMENT</span>
            <h2>Ternux চালায় Linux. ADT বানায় Android app.</h2>
            <p>
              Ternux দেয় Debian desktop। ADT সেই guest-এর ভেতরে native Android
              development toolchain যোগ করে: SDK build-tools, platform-tools,
              signing, ADB, Flutter/Dart ও native build tools। দুই project-এর
              device workflow আলাদাভাবে verified; Xfce terminal থেকে ADT চালানো
              observed, তবে একসঙ্গে পুরো workflow formally qualified নয়।
            </p>
            <div class="ecosystem-tags" aria-label="ADT toolchain">
              <span>ANDROID SDK</span>
              <span>ADB</span>
              <span>NDK</span>
              <span>FLUTTER · DART</span>
              <span>CMAKE · NINJA</span>
            </div>
            <a class="button" href="https://github.com/soobujmiah/adt">
              ADT TOOLCHAIN খুলুন ↗
            </a>
          </div>
        </div>
      </div>
    </section>
    <section class="section compute-section" id="local-inference" data-reveal>
      <div class="container">
        <header class="section-head">
          <span class="eyebrow">05 / ON-DEVICE INFERENCE</span>
          <div>
            <h2>একই model. তিনটি compute path.</h2>
            <p>
              Redmi Turbo 4 Pro-তে মাপা CPU, Adreno Vulkan ও পরীক্ষামূলক Hexagon
              HTP ফলের মধ্যে switch করুন। প্রতিটি সংখ্যার সঙ্গে model ও
              evidence-এর সীমা দেখানো আছে।
            </p>
          </div>
        </header>
        <ComputeBench lang="bn" />
      </div>
    </section>
    <section class="section render-section" id="benchmarks" data-reveal>
      <div class="container">
        <header class="section-head">
          <span class="eyebrow">06 / VERIFIED 3D OUTPUT</span>
          <div>
            <h2>Mesh থেকে motion.</h2>
            <p>
              Redmi Turbo 4 Pro-তে Blender 4.3.2, MPFB2 2.0.18 ও EEVEE Next
              দিয়ে measured. প্রতিটি ধাপ বাস্তব output দেখায়।
            </p>
          </div>
        </header>
        <RenderBench lang="bn" />
        <p class="notice">
          MPFB2 দিয়ে anatomically correct base mesh তৈরি হয়। Grooming,
          finished material, expressive pose ও photoreal presentation-এর জন্য
          আরও কাজ দরকার।
        </p>
        <a class="home-section-link" href="/ternux/bn/docs/BENCHMARKS.html">
          সম্পূর্ণ benchmark log →
        </a>
      </div>
    </section>
  </main>
</SiteLayout>
