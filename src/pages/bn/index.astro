---
import SiteLayout from "../../layouts/SiteLayout.astro";
import WorkstationDiagram from "../../components/WorkstationDiagram.astro";
import ComputeBench from "../../components/ComputeBench.astro";
import RenderBench from "../../components/RenderBench.astro";
---

<SiteLayout
  title="পকেটেই লিনাক্স ওয়ার্কস্টেশন"
  description="Ternux v2.0.0 হলো root ছাড়া ARM64 Android Linux workstation: Debian, Ubuntu ও Alpine desktop profile, copyable install path এবং প্রকাশিত v3 roadmap-সহ।"
  lang="bn"
  canonical="/bn/"
  altUrl="/"
>
  <main id="main">
    <section class="home-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">অ্যান্ড্রয়েড × লিনাক্স · এআরএম৬৪</span>
          <h1 aria-label="লিনাক্স ওয়ার্কস্টেশন আপনার পকেটে, সবুজ মিয়া">
            <span class="matrix-title" data-matrix-title aria-hidden="true">
              <span class="matrix-title-text">লিনাক্স</span>
            </span>
            <br />
            <em class="hero-tagline" aria-hidden="true">
              ওয়ার্কস্টেশন আপনার পকেটে
            </em>
            <span class="hero-signature" aria-label="সবুজ মিয়া">
              সবুজ মিয়া
            </span>
          </h1>
          <p>
            Android ফোনে root ছাড়া Linux desktop চালান। v2-তে Debian, Ubuntu ও
            Alpine—এই তিনটি desktop profile supported; Debian recommended
            default। আরও ১২টি named distro recipe আছে, তবে সেগুলো v2-তে
            qualified নয়। Device evidence এক Redmi Turbo 4 Pro থেকে; exact
            coverage release report-এ আছে।
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#install">
              install পদ্ধতি বেছে নিন <span>↓</span>
            </a>
            <a class="button" href="/ternux/bn/docs/ARCHITECTURE.html">
              স্তরবিন্যাস দেখুন <span>→</span>
            </a>
          </div>
          <div class="hero-label">
            রুট লাগবে না　/　ওপেন সোর্স　/　প্রমাণভিত্তিক
          </div>
        </div>
        <div
          class="hero-system-route"
          aria-label="টার্নাক্সের ব্যবস্থাপথ: অ্যান্ড্রয়েড, টার্মাক্স, PRoot guest, Termux:X11"
        >
          <span>
            অ্যান্ড্রয়েড <b>মূল যন্ত্র</b>
          </span>
          <span>
            টার্মাক্স <b>কমান্ড পরিবেশ</b>
          </span>
          <span>
            PRoot guest <b>Debian · Ubuntu · Alpine</b>
          </span>
          <span>
            Termux:X11 <b>display · audio</b>
          </span>
        </div>
      </div>
    </section>
    <section class="section" id="supported-guests" data-reveal>
      <div class="container">
        <div class="device-panel profile-panel">
          <div class="device-copy">
            <span class="eyebrow">০১ / v2-তে সমর্থিত desktop guest</span>
            <h2>নিজের Linux guest বেছে নিন।</h2>
            <p>
              এই তিনটি profile v2 desktop support-এর অন্তর্ভুক্ত। Debian হলো
              default; বাকি ১২টি recipe আছে, তবে qualified নয়।
            </p>
          </div>
          <div class="profile-grid">
            <article class="profile-card is-recommended">
              <small>RECOMMENDED DEFAULT</small>
              <strong>Debian</strong>
              <span>XFCE · APT · Avro</span>
            </article>
            <article class="profile-card">
              <small>SUPPORTED GUEST</small>
              <strong>Ubuntu</strong>
              <span>XFCE · APT · snap-safe</span>
            </article>
            <article class="profile-card">
              <small>SUPPORTED GUEST</small>
              <strong>Alpine</strong>
              <span>XFCE · APK · Avro m17n</span>
            </article>
          </div>
        </div>
      </div>
    </section>
    <section class="section" id="system-map" data-reveal>
      <div class="container">
        <header class="section-head">
          <span class="eyebrow">০২ / ব্যবস্থার মানচিত্র</span>
          <div>
            <h2>
              একটি ডিভাইস।
              <br />
              স্তরে সাজানো ওয়ার্কস্টেশন।
            </h2>
            <p>
              প্রতিটি অংশের কাজ নির্দিষ্ট। টার্নাক্স মূল যন্ত্র, লিনাক্সের
              পরিবেশ, স্ক্রিন ও গ্রাফিক্সের পথকে একটি যাচাইযোগ্য ব্যবস্থায়
              সাজায়।
            </p>
          </div>
        </header>
        <div
          class="architecture"
          aria-label="অ্যান্ড্রয়েড থেকে লিনাক্স ও জিপিইউ ব্যবস্থার প্রবাহ"
        >
          <article class="arch-stage" data-index="০১ / মূল যন্ত্র">
            <span class="arch-pulse"></span>
            <h3>অ্যান্ড্রয়েড</h3>
            <p>ফোনের যন্ত্রাংশ ও কার্নেল</p>
          </article>
          <article class="arch-stage" data-index="০২ / কমান্ড পরিবেশ">
            <span class="arch-pulse"></span>
            <h3>টার্মাক্স</h3>
            <p>এআরএম৬৪-এর নিজস্ব সরঞ্জাম</p>
          </article>
          <article class="arch-stage" data-index="০৩ / লিনাক্স">
            <span class="arch-pulse"></span>
            <h3>প্রুট · ১৫টি guest profile</h3>
            <p>আলাদা অতিথি পরিবেশ · এক্সএফসিই</p>
          </article>
          <article class="arch-stage" data-index="০৪ / স্ক্রিন">
            <span class="arch-pulse"></span>
            <h3>টার্মাক্স:এক্স১১</h3>
            <p>অ্যান্ড্রয়েড X server · আলাদা guest window</p>
          </article>
          <article class="arch-stage" data-index="০৫ / জিপিইউ">
            <span class="arch-pulse"></span>
            <h3>জিঙ্ক · টার্নিপ</h3>
            <p>অ্যাড্রেনো ৮২৫-এ Debian, Ubuntu ও Alpine যাচাই</p>
          </article>
          <article class="arch-stage" data-index="০৬ / প্রস্তুত">
            <span class="arch-pulse"></span>
            <h3>টার্নাক্স</h3>
            <p>এক ফোনেই সম্পূর্ণ ওয়ার্কস্টেশন</p>
          </article>
        </div>
        <div class="system-device">
          <WorkstationDiagram lang="bn" />
        </div>
      </div>
    </section>
    <section class="section" id="install" data-reveal>
      <div class="container">
        <div class="install-panel">
          <div>
            <span class="eyebrow">০৩ / প্রথমবার চালু</span>
            <h2>লিনাক্স ওয়ার্কস্টেশন চালু করুন।</h2>
            <p>
              একই signing source থেকে Termux ও Termux:X11 install করুন, তারপর
              নিচের copyable installation path বেছে নিন। প্রয়োজনীয় add-on-এর
              download link-ও এখানে আছে। X11 desktop সামনে থাকলে Android-এর
              background throttling কমাতে{" "}
              <a href="https://github.com/termux/termux-x11/releases/tag/nightly">
                Termux:X11 shared-UID debug APK
              </a>
              ব্যবহার করা যায়; এটি GitHub-signed Termux চায়। F-Droid ও Google
              Play-এর Termux হলে একই release page-এর সাধারণ universal debug APK
              নিন।
            </p>
            <p
              class="install-links"
              aria-label="Termux ও companion app download"
            >
              <a href="https://f-droid.org/packages/com.termux/">
                Termux · F-Droid ↗
              </a>
              <a href="https://github.com/termux/termux-app/releases">
                Termux · GitHub ↗
              </a>
              <a href="https://github.com/termux/termux-api/releases">
                Termux:API · GitHub ↗
              </a>
              <a href="https://f-droid.org/packages/com.termux.api/">
                Termux:API · F-Droid ↗
              </a>
              <a href="https://github.com/termux/termux-boot/releases">
                Termux:Boot · GitHub ↗
              </a>
              <a href="https://f-droid.org/packages/com.termux.boot/">
                Termux:Boot · F-Droid ↗
              </a>
              <a href="https://github.com/termux/termux-styling/releases">
                Termux:Styling · GitHub ↗
              </a>
              <a href="https://f-droid.org/packages/com.termux.styling/">
                Termux:Styling · F-Droid ↗
              </a>
              <a href="https://github.com/termux/termux-x11/releases/tag/nightly">
                Termux:X11 APKs ↗
              </a>
            </p>
            <a
              class="home-section-link"
              href="/ternux/bn/docs/INSTALLATION.html"
            >
              স্থাপনের নির্দেশিকা ↗
            </a>
            <a class="home-section-link" href="/ternux/bn/docs/MANUAL.html">
              হাতে install-এর ধাপ দেখুন ↗
            </a>
            <a
              class="home-section-link"
              href="/ternux/bn/docs/QUICK-START.html"
            >
              দ্রুত শুরু ↗
            </a>
            <p>
              Signed APT path Ternux-কে Termux package manager-এ যোগ করে।
              একবারের bootstrap signing key যাচাই করে; এরপর host CLI-র জন্য
              <code>pkg install ternux</code>, তারপর guest বাছতে
              <code>tx install</code> চালান। Package command নিজে guest install
              করে না। ধাপগুলো{" "}
              <a href="/ternux/bn/docs/TERMUX-APT.html">APT setup guide ↗</a>-এ
              আছে। Termux:API-এর জন্য Termux-এর ভিতরে matching{" "}
              <code>termux-api</code> package-ও লাগবে।
            </p>
          </div>
          <div class="command">
            <small>এক command · curl</small>
            <button
              type="button"
              data-copy
              data-copy-value="pkg update -y && pkg install -y curl && curl -fsSL https://raw.githubusercontent.com/soobujmiah/ternux/main/install.sh | bash"
            >
              কপি
            </button>
            <code>
              pkg update -y && pkg install -y curl && curl -fsSL …/install.sh |
              bash
            </code>
          </div>
          <div class="command">
            <small>Signed APT · curl bootstrap</small>
            <button
              type="button"
              data-copy
              data-copy-value="pkg update -y && pkg install -y curl gnupg && curl -fsSLo $TMPDIR/ternux-bootstrap.sh https://soobujmiah.github.io/ternux/apt/bootstrap.sh && bash $TMPDIR/ternux-bootstrap.sh && pkg install ternux"
            >
              কপি
            </button>
            <code>
              pkg update -y && pkg install -y curl gnupg && curl -fsSLo
              $TMPDIR/ternux-bootstrap.sh
              https://soobujmiah.github.io/ternux/apt/bootstrap.sh && bash
              $TMPDIR/ternux-bootstrap.sh && pkg install ternux
            </code>
            <small>
              এতে host CLI install হবে; guest desktop বেছে নিতে{" "}
              <code>tx install</code> চালান।
            </small>
          </div>
          <div class="command">
            <small>এক command · wget</small>
            <button
              type="button"
              data-copy
              data-copy-value="pkg update -y && pkg install -y wget && wget -qO- https://raw.githubusercontent.com/soobujmiah/ternux/main/install.sh | bash"
            >
              কপি
            </button>
            <code>
              pkg update -y && pkg install -y wget && wget -qO- …/install.sh |
              bash
            </code>
          </div>
          <div class="command">
            <small>Signed APT · wget bootstrap</small>
            <button
              type="button"
              data-copy
              data-copy-value="pkg update -y && pkg install -y wget gnupg && wget -qO $TMPDIR/ternux-bootstrap.sh https://soobujmiah.github.io/ternux/apt/bootstrap.sh && bash $TMPDIR/ternux-bootstrap.sh && pkg install ternux"
            >
              কপি
            </button>
            <code>
              pkg update -y && pkg install -y wget gnupg && wget -qO
              $TMPDIR/ternux-bootstrap.sh
              https://soobujmiah.github.io/ternux/apt/bootstrap.sh && bash
              $TMPDIR/ternux-bootstrap.sh && pkg install ternux
            </code>
            <small>
              এতে host CLI install হবে; guest desktop বেছে নিতে{" "}
              <code>tx install</code> চালান।
            </small>
          </div>
        </div>
      </div>
    </section>
    <section class="section" id="project-status" data-reveal>
      <div class="container">
        <div class="device-panel profile-panel status-panel">
          <div class="device-copy">
            <span class="eyebrow">প্রকল্পের অবস্থা · ১৩ নভেম্বর ২০২৬</span>
            <h2>v2 স্থিতিশীল release। v3-এর ভিত্তি প্রকাশিত।</h2>
            <p>
              Ternux 2.0.0 বর্তমান stable release। Debian, Ubuntu ও Alpine v2-এর
              তিন desktop profile; device evidence Redmi Turbo 4 Pro-তে করা,
              পরীক্ষার সীমানা audit report-এ দেওয়া আছে। আরও ১২টি named recipe
              আছে, তবে সেগুলো v2-qualified নয়। Current main source-এ চারটি
              read-only manager CLI command এবং foreground Unix-socket service
              আছে; stable 2.0.0 package-এ নেই। Background supervision, native
              workspace, graphical Control Center ও staged migration এখনো বাকি।
              নতুন profile-এ :0 native Termux-এর জন্য; Debian :1, Ubuntu :2,
              Alpine :3 পাবে। Existing v2 display assignment সংরক্ষিত থাকে।
            </p>
          </div>
          <div class="profile-grid">
            <a
              class="profile-card"
              href="https://github.com/soobujmiah/ternux/releases/latest"
            >
              <small>STABLE RELEASE</small>
              <strong>v2.0.0</strong>
              <span>Release notes ও package ↗</span>
            </a>
            <a class="profile-card" href="/ternux/bn/docs/V3-ARCHITECTURE.html">
              <small>PROJECT ROADMAP</small>
              <strong>v3</strong>
              <span>বর্তমান অবস্থা ও পরবর্তী কাজ ↗</span>
            </a>
            <a class="profile-card" href="https://github.com/soobujmiah/ternux">
              <small>REPOSITORY</small>
              <strong>main</strong>
              <span>Source, issue ও পরিবর্তন ↗</span>
            </a>
            <a
              class="profile-card"
              href="/ternux/bn/docs/release/V2-RELEASE-REPORT.html"
            >
              <small>LIVE AUDIT SNAPSHOT</small>
              <strong>১৩ Nov</strong>
              <span>Package, device ও website evidence ↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>
    <section
      class="section ecosystem-section"
      id="android-development"
      data-reveal
    >
      <div class="container">
        <div class="ecosystem-panel">
          <div class="ecosystem-graphic" aria-hidden="true">
            <span class="ecosystem-node ecosystem-ternux">
              টার্
              <br />
              নাক্স
            </span>
            <span class="ecosystem-link"></span>
            <span class="ecosystem-node ecosystem-adt">এডিটি</span>
            <span class="ecosystem-caption">এক যন্ত্র · দুই কাজের পরিবেশ</span>
          </div>
          <div class="ecosystem-copy">
            <span class="eyebrow">০৪ / অ্যান্ড্রয়েড উন্নয়ন</span>
            <h2>
              টার্নাক্সে লিনাক্স চলে। এডিটি দিয়ে অ্যান্ড্রয়েড অ্যাপ তৈরি হয়।
            </h2>
            <p>
              Ternux v2-তে Debian, Ubuntu ও Alpine desktop guest supported;
              Debian recommended default। আরও ১২টি named distro recipe আছে, তবে
              v2-তে qualified নয়। Ubuntu-র snap-safe setup আছে। ADT ওই guest-এ
              Android SDK build-tools, platform-tools, signing, ADB,
              Flutter/Dart ও native build tools যোগ করে। ADT workflow-এর
              বিস্তারিত আলাদা guide-এ আছে.
            </p>
            <div class="ecosystem-tags" aria-label="এডিটি নির্মাণ-সরঞ্জাম">
              <span>অ্যান্ড্রয়েড এসডিকে</span>
              <span>এডিবি</span>
              <span>এনডিকে</span>
              <span>ফ্লাটার · ডার্ট</span>
              <span>সিমেক · নিনজা</span>
            </div>
            <a class="button" href="https://github.com/soobujmiah/adt">
              এডিটি সরঞ্জাম খুলুন ↗
            </a>
          </div>
        </div>
      </div>
    </section>
    <section class="section compute-section" id="local-inference" data-reveal>
      <div class="container">
        <header class="section-head">
          <span class="eyebrow">০৫ / যন্ত্রে কৃত্রিম বুদ্ধিমত্তা</span>
          <div>
            <h2>একই মডেল। গণনার তিনটি পথ।</h2>
            <p>
              একই Android reference device-এ মাপা CPU ও Adreno Vulkan ফল দেখুন;
              Hexagon HTP আলাদা experimental result। এগুলো অন্য device-এর
              performance guarantee নয়।
            </p>
          </div>
        </header>
        <ComputeBench lang="bn" />
      </div>
    </section>
    <section class="section render-section" id="benchmarks" data-reveal>
      <div class="container">
        <header class="section-head">
          <span class="eyebrow">০৬ / যাচাইকৃত ত্রিমাত্রিক ফল</span>
          <div>
            <h2>ত্রিমাত্রিক মেশ থেকে চলমান দৃশ্য।</h2>
            <p>
              রেডমি টার্বো ৪ প্রোতে ব্লেন্ডার ৪.৩.২, এমপিএফবি২ ২.০.১৮ ও ইভি
              নেক্সট দিয়ে মাপা। প্রতিটি ধাপে বাস্তব ফল দেখানো হয়েছে।
            </p>
          </div>
        </header>
        <RenderBench lang="bn" />
        <div
          class="render-extra-results"
          aria-label="দীর্ঘ অ্যানিমেশন রেন্ডারের মাপা ফল"
        >
          <article>
            <small>২৭ সেকেন্ডের অ্যানিমেশন</small>
            <strong>৬৪৮ ফ্রেম</strong>
            <span>গড়ে ১.১২৬ সেকেন্ড প্রতি ফ্রেম · ইভি নেক্সট</span>
          </article>
          <article>
            <small>বাংলা সংলাপসহ এক মিনিটের চলচ্চিত্র</small>
