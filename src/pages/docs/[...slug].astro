---
import DocumentationLayout from "../../components/DocumentationLayout.astro";
import { allPages, pageUrl } from "../../lib/content";

export function getStaticPaths() {
  return allPages("en")
    .filter((page) => !page.route.endsWith("/index.md"))
    .map((page) => ({
      params: {
        slug: page.route.replace(/^docs\//, "").replace(/\.md$/, ""),
      },
      props: { page, lang: "en" },
    }));
}

const { page, lang } = Astro.props;
const canonical = pageUrl(page).replace("/ternux", "");
const noIndex =
  page.route.endsWith("ACCELERATOR-RELEASE-PLAN.md") ||
  /^(?:bn\/)?docs\/(?:v3|project)\//.test(page.route);
---

<DocumentationLayout
  page={page}
  lang={lang}
  canonical={canonical}
  noIndex={noIndex}
/>
