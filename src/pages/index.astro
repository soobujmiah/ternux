---
import SiteLayout from "../layouts/SiteLayout.astro";
import WorkstationDiagram from "../components/WorkstationDiagram.astro";
import ComputeBench from "../components/ComputeBench.astro";
import RenderBench from "../components/RenderBench.astro";

const installCommand = `pkg update -y && pkg upgrade -y && pkg install -y curl wget && bash -c 's=$(mktemp) && (curl -fsSL https://raw.githubusercontent.com/soobujmiah/ternux/c2a008cc4e6dc038fdf324f5128e2205e8a1583a/install.sh -o "$s" || wget -qO "$s" https://raw.githubusercontent.com/soobujmiah/ternux/c2a008cc4e6dc038fdf324f5128e2205e8a1583a/install.sh) && bash "$s"; r=$?; rm -f "$s"; exit "$r"'`;
---

<SiteLayout
  title="Android Linux Workstation & Local AI Lab | Ternux"
  description="Turn an ARM64 Android phone into a no-root Linux workstation. Run Debian desktops, CPU/Vulkan local LLMs, preview Stable Diffusion, Blender GPU rendering and developer tools with Ternux."
  canonical="/"
  altUrl="/bn/"
>
  <main id="main">
    <section class="home-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">ANDROID × LINUX · ARM64</span>
          <h1 aria-label="Linux desktop on Android, without root">
            <span class="matrix-title" data-matrix-title aria-hidden="true">
              <span class="matrix-title-text">LINUX</span>
            </span>
            <br />
            <em class="hero-tagline" aria-hidden="true">
              A Mobile Linux Workstation
            </em>
            <span class="hero-signature">NO ROOT · ARM64</span>
          </h1>
          <p>
            Turn an ARM64 Android phone into a no-root Linux workstation and
            on-device computing lab. Run Debian, Ubuntu, Kali Linux or Alpine
            desktops, develop Android apps, render Blender scenes on the Adreno
            GPU, and explore local CPU/Vulkan AI workloads including LLM
            inference and preview image generation. Hexagon HTP and QNN remain
            experimental; results are device-specific, not universal guarantees.
            Debian is the recommended verified v2 desktop profile.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#install">
              INSTALL TERNux <span>↓</span>
            </a>
            <a class="button" href="/ternux/docs/ARCHITECTURE.html">
              HOW IT WORKS <span>→</span>
            </a>
          </div>
          <div class="hero-label">
            NO ROOT REQUIRED　/　OPEN SOURCE　/　EVIDENCE LED
          </div>
        </div>
        <div
          class="hero-system-route"
          aria-label="Ternux system route: Android, Termux, a PRoot guest, Termux:X11"
        >
          <span class="route-heading">SYSTEM ROUTE / READY</span>
          <span>
            ANDROID <b>HOST</b>
          </span>
          <span>
            TERMUX <b>SHELL</b>
          </span>
          <span>
            PRoot <b>DEBIAN · UBUNTU · KALI · ALPINE</b>
          </span>
          <span>
            TERMUX:X11 <b>DISPLAY · AUDIO</b>
          </span>
        </div>
      </div>
    </section>
    <section class="section" id="supported-guests" data-reveal>
      <div class="container">
        <div class="device-panel profile-panel">
          <div class="device-copy">
            <span class="eyebrow">01 / V2 SUPPORTED DESKTOP GUESTS</span>
            <h2>Choose your Linux guest.</h2>
            <p>
              These four profiles form the v2 verified baseline. Debian is the
              default; eleven more recipes are available but not qualified.
            </p>
          </div>
          <div class="profile-grid">
            <article class="profile-card is-recommended">
              <small>RECOMMENDED DEFAULT</small>
              <strong>Debian</strong>
              <span>Xfce · APT · Avro</span>
            </article>
            <article class="profile-card">
              <small>SUPPORTED GUEST</small>
              <strong>Ubuntu</strong>
              <span>Xfce · APT · snap-safe</span>
            </article>
            <article class="profile-card">
              <small>SUPPORTED GUEST</small>
              <strong>Kali Linux</strong>
              <span>Xfce · APT · security tools</span>
            </article>
            <article class="profile-card">
              <small>SUPPORTED GUEST</small>
              <strong>Alpine</strong>
              <span>Xfce · APK · Avro m17n</span>
            </article>
          </div>
        </div>
      </div>
    </section>
    <section class="section" id="system-map" data-reveal>
      <div class="container">
        <header class="section-head">
          <span class="eyebrow">02 / SYSTEM MAP</span>
          <div>
            <h2>
              One device.
              <br />A layered workstation.
            </h2>
            <p>
              Each boundary has a clear job. Ternux assembles the host, Linux
              environment, display and graphics route into one inspectable
              system.
            </p>
          </div>
        </header>
        <div
          class="architecture"
          aria-label="Android to Linux and GPU system flow"
        >
          <article class="arch-stage" data-index="01 / HOST">
            <span class="arch-pulse"></span>
            <h3>Android</h3>
            <p>Phone hardware and kernel</p>
          </article>
          <article class="arch-stage" data-index="02 / SHELL">
            <span class="arch-pulse"></span>
            <h3>Termux</h3>
            <p>Native ARM64 tools</p>
          </article>
          <article class="arch-stage" data-index="03 / LINUX">
            <span class="arch-pulse"></span>
            <h3>PRoot · 15 named profiles</h3>
            <p>Independent guests · Xfce</p>
          </article>
          <article class="arch-stage" data-index="04 / DISPLAY">
            <span class="arch-pulse"></span>
            <h3>Termux:X11</h3>
            <p>Android X server · tagged guest windows</p>
          </article>
          <article class="arch-stage" data-index="05 / GPU">
            <span class="arch-pulse"></span>
            <h3>VirGL · Zink</h3>
            <p>
              Native distro Mesa · four installed profiles checked on Adreno
              825; qualification is device-bounded
            </p>
          </article>
          <article class="arch-stage" data-index="06 / READY">
            <span class="arch-pulse"></span>
            <h3>Ternux</h3>
            <p>One complete workstation</p>
          </article>
        </div>
        <div class="system-device">
          <WorkstationDiagram lang="en" />
        </div>
      </div>
    </section>
    <section class="section" id="install" data-reveal>
      <div class="container">
        <div class="install-panel">
          <div>
            <span class="eyebrow">03 / FIRST BOOT</span>
            <h2>Bring your Linux workstation online.</h2>
            <p>
              Install Termux and Termux:X11 from compatible sources, then use
              one of the copyable installation paths below. Add-on downloads are
              linked here too. Keep Termux and its add-ons from the same signing
              source. The{" "}
              <a href="https://github.com/termux/termux-x11/releases/tag/nightly">
                Termux:X11 shared-UID debug APK
              </a>
              can reduce Android background throttling while the X11 desktop is
              foreground; it requires the GitHub-signed Termux app. F-Droid and
              Google Play users should use the standard universal debug APK from
              the same release page.
            </p>
            <p
              class="install-links"
              aria-label="Termux and companion app downloads"
            >
              <a href="https://f-droid.org/packages/com.termux/">
                Termux · F-Droid ↗
              </a>
              <a href="https://github.com/termux/termux-app/releases">
                Termux · GitHub ↗
              </a>
              <a href="https://github.com/termux/termux-api/releases">
                Termux:API · GitHub ↗
              </a>
              <a href="https://f-droid.org/packages/com.termux.api/">
                Termux:API · F-Droid ↗
              </a>
              <a href="https://github.com/termux/termux-boot/releases">
                Termux:Boot · GitHub ↗
              </a>
              <a href="https://f-droid.org/packages/com.termux.boot/">
                Termux:Boot · F-Droid ↗
              </a>
              <a href="https://github.com/termux/termux-styling/releases">
                Termux:Styling · GitHub ↗
              </a>
              <a href="https://f-droid.org/packages/com.termux.styling/">
                Termux:Styling · F-Droid ↗
              </a>
              <a href="https://github.com/termux/termux-x11/releases/tag/nightly">
                Termux:X11 APKs ↗
              </a>
            </p>
            <a class="home-section-link" href="/ternux/docs/INSTALLATION.html">
              READ INSTALLATION NOTES ↗
            </a>
            <a class="home-section-link" href="/ternux/docs/MANUAL.html">
              REVIEW THE MANUAL INSTALL ↗
            </a>
            <a class="home-section-link" href="/ternux/docs/QUICK-START.html">
              QUICK START ↗
            </a>
            <p>
              Ternux v2.0.0 and its stable APT distribution were withdrawn on
              2026-11-14. The source tag remains for provenance. Use the source
              installer below; <code>/apt-rc</code> is reserved for opt-in
              candidate testing. Termux:API also needs the matching
              <code>termux-api</code> package inside Termux.
            </p>
          </div>
          <div class="command">
            <span class="command-kicker">TERMUX · ONE-COMMAND INSTALL</span>
            <small>SAFE BOOTSTRAP · CURL WITH WGET FALLBACK</small>
            <button type="button" data-copy data-copy-value={installCommand}>
              COPY
            </button>
            <code>{installCommand}</code>
          </div>
          <p class="install-note">
            The command finishes the Termux package upgrade, installs both
            downloaders, and retries the script download with wget if curl
            fails. It runs the saved script only after a successful download. If
            an installation stops at a required phase, rerun this command to
            download the current installer and resume from that phase. If a
            partial upgrade broke <code>pkg</code> or curl, repair it with the
            apt-first command above. The stable APT channel is withdrawn, so{" "}
            <code>pkg install ternux</code> is currently unavailable;
            <a href="/ternux/docs/TERMUX-APT.html">
              see current channel status ↗
            </a>
            .
          </p>
        </div>
      </div>
    </section>
    <section class="section" id="project-status" data-reveal>
      <div class="container">
        <div class="device-panel profile-panel status-panel">
          <div class="device-copy">
            <span class="eyebrow">PROJECT STATUS · 20 NOV 2026</span>
            <h2>v2.0.0 withdrawn. v2.0.1 source release published.</h2>
            <p>
              The v2.0.0 GitHub release and stable APT distribution were
              withdrawn on 2026-11-14; the source tag is retained for
              provenance. Debian, Ubuntu, Kali Linux and Alpine form the four
              verified v2 desktop profiles; evidence depth differs by profile.
              Current main includes four read-only manager CLI commands, a
              foreground Unix-socket service, and `tx control`, a loopback
              dashboard with confirmed desktop start/stop actions and durable
              local job records (optional Python 3). The v2.0.1 source archive
              is published from the verified tag; see the
              <a href="/ternux/docs/release/pages/v2.0.1-INSTALLATION.html">
                exact-version installation guide
              </a>
              . Full service supervision, broader dashboard coverage and the new
              v3 platform architecture remain future work. Stable APT remains
              withdrawn.
            </p>
          </div>
          <div class="profile-grid">
            <a
              class="profile-card"
              href="/ternux/docs/V2-RELEASE-READINESS.html"
            >
              <small>V2 DISTRIBUTION STATUS</small>
              <strong>v2.0.1 published</strong>
              <span>Read the release record ↗</span>
            </a>
            <a
              class="profile-card"
              href="/ternux/docs/project/PROJECT-ROADMAP.html"
            >
              <small>PROJECT ROADMAP</small>
              <strong>v3 future scope</strong>
              <span>Current status & next steps ↗</span>
            </a>
            <a class="profile-card" href="https://github.com/soobujmiah/ternux">
              <small>REPOSITORY</small>
              <strong>main</strong>
              <span>Source, issues & changes ↗</span>
            </a>
            <a
              class="profile-card"
              href="/ternux/docs/release/V2-RELEASE-REPORT.html"
            >
              <small>WITHDRAWAL RECORD</small>
              <strong>14 Nov</strong>
              <span>Channel status and historical evidence ↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>
    <section
      class="section ecosystem-section"
      id="android-development"
      data-reveal
    >
      <div class="container">
        <div class="ecosystem-panel">
          <div class="ecosystem-graphic" aria-hidden="true">
            <span class="ecosystem-node ecosystem-ternux">
              TERN
              <br />
              UX
            </span>
            <span class="ecosystem-link"></span>
            <span class="ecosystem-node ecosystem-adt">ADT</span>
            <span class="ecosystem-caption">ONE DEVICE · TWO TOOLSETS</span>
          </div>
          <div class="ecosystem-copy">
            <span class="eyebrow">04 / ANDROID DEVELOPMENT</span>
            <h2>Ternux runs Linux. ADT develops Android.</h2>
            <p>
              Ternux v2 verifies Debian, Ubuntu, Kali Linux and Alpine desktop
              guests; Debian is the recommended default. Eleven more named
              distro recipes are available but not in the v2 verified baseline.
              Ubuntu has its own snap-safe setup. ADT adds Android SDK
              build-tools, platform-tools, signing, ADB, Flutter/Dart and native
              build tools inside the guest. ADT's Android development workflow
              is documented separately.
            </p>
            <div class="ecosystem-tags" aria-label="ADT toolchain">
              <span>ANDROID SDK</span>
              <span>ADB</span>
              <span>NDK</span>
              <span>FLUTTER · DART</span>
              <span>CMAKE · NINJA</span>
            </div>
            <a class="button" href="https://github.com/soobujmiah/adt">
              OPEN ADT TOOLCHAIN ↗
            </a>
          </div>
        </div>
      </div>
    </section>
    <section class="section compute-section" id="local-inference" data-reveal>
      <div class="container">
        <header class="section-head">
          <span class="eyebrow">05 / ON-DEVICE INFERENCE</span>
          <div>
            <h2>One model. Three compute paths.</h2>
            <p>
              Compare CPU and Adreno Vulkan measurements from one Android
              reference device. Hexagon HTP appears separately as experimental;
              these results are not performance guarantees for other devices.
            </p>
          </div>
        </header>
        <ComputeBench lang="en" />
      </div>
    </section>
    <section class="section render-section" id="benchmarks" data-reveal>
      <div class="container">
        <header class="section-head">
          <span class="eyebrow">06 / VERIFIED 3D OUTPUT</span>
          <div>
            <h2>From mesh to motion.</h2>
            <p>
              Measured on the Redmi Turbo 4 Pro with Blender 4.3.2, MPFB2 2.0.18
              and EEVEE Next. Each point shows a real output stage.
            </p>
          </div>
        </header>
        <RenderBench lang="en" />
        <div
          class="render-extra-results"
          aria-label="Measured longer animation render results"
        >
          <article>
            <small>27-second animated short</small>
            <strong>648 frames</strong>
            <span>1.126 s per frame mean · EEVEE Next</span>
          </article>
          <article>
            <small>One-minute Bengali short film</small>
            <strong>1,440 frames</strong>
            <span>1.944 s per frame mean · EEVEE Next</span>
          </article>
        </div>
        <p class="notice">
          MPFB2 creates an anatomically correct base mesh. Grooming, finished
          materials, expressive posing and photoreal presentation need further
          work.
        </p>
        <a class="home-section-link" href="/ternux/docs/BENCHMARKS.html">
          OPEN COMPLETE BENCHMARK LOG →
        </a>
      </div>
    </section>
    <section
      class="section evidence-section"
      id="tests-and-evidence"
      data-reveal
    >
      <div class="container">
        <header class="section-head">
          <span class="eyebrow">07 / TESTS · REPORTS · CAPABILITY</span>
          <div>
            <h2>See what is tested. Read what is measured.</h2>
            <p>
              Ternux publishes the boundaries as clearly as the results.
              Automated repository checks, device measurements and supported
              guest profiles answer different questions; none should be mistaken
              for universal device certification.
            </p>
          </div>
        </header>
        <div class="evidence-grid">
          <a
            class="evidence-card"
            href="https://github.com/soobujmiah/ternux/actions/workflows/ci.yml"
          >
            <small>ENGINEERING / AUTOMATED CHECKS</small>
            <strong>Test suites & CI</strong>
            <span>
              Shell and Python behavior, manager contracts, lifecycle checks,
              documentation links and static website structure are exercised in
              repository automation. A CI result is not a device-wide promise.
            </span>
            <i>VIEW CI WORKFLOW ↗</i>
          </a>
          <a class="evidence-card" href="/ternux/docs/BENCHMARKS.html">
            <small>DEVICE / PRESERVED MEASUREMENTS</small>
            <strong>Benchmarks & methods</strong>
            <span>
              Read the recorded graphics, compute and render results alongside
              device details, commands, evidence labels and known limits.
            </span>
            <i>READ BENCHMARK REPORT ↗</i>
          </a>
          <article class="evidence-card">
            <small>SUPPORT / QUALIFICATION SCOPE</small>
            <strong>Capabilities & audit</strong>
            <span>
              Four v2 desktop profiles are supported; eleven additional named
              recipes are not in that verified baseline. Review the support
              boundaries and audit record before choosing a path.
            </span>
            <div class="evidence-card-links">
              <a href="https://github.com/soobujmiah/ternux/blob/main/docs/audit/FEATURE-MATRIX.md">
                FEATURE MATRIX ↗
              </a>
              <a href="https://github.com/soobujmiah/ternux/blob/main/docs/audit/REPOSITORY-FULL-AUDIT-2026-11-20.md">
                FULL REPOSITORY AUDIT · 20 NOV 2026 ↗
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
