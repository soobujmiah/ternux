---
import SiteLayout from "../layouts/SiteLayout.astro";
import WorkstationDiagram from "../components/WorkstationDiagram.astro";
import ComputeBench from "../components/ComputeBench.astro";
import RenderBench from "../components/RenderBench.astro";
---

<SiteLayout
  title="Linux, beyond the desktop"
  description="A no-root Linux workstation for Android ARM64: Debian, Ubuntu, and Alpine are supported in v2, with 15 named distro recipes available."
  canonical="/"
  altUrl="/bn/"
>
  <main id="main">
    <section class="home-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">ANDROID × LINUX · ARM64</span>
          <h1 aria-label="LINUX Workstation In Your Pocket, Soobujmiah">
            <span class="matrix-title" data-matrix-title aria-hidden="true">
              <span class="matrix-title-text">LINUX</span>
            </span>
            <br />
            <em class="hero-tagline" aria-hidden="true">
              Workstation In Your Pocket
            </em>
            <span class="hero-signature" aria-label="Soobujmiah">
              Soobujmiah
            </span>
          </h1>
          <p>
            Run a Linux desktop on Android without root. Debian, Ubuntu, and
            Alpine are the three supported v2 desktop profiles, with Debian as
            the recommended default. Twelve more named distro recipes are
            available, but are not qualified for v2 support.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="/ternux/docs/QUICK-START.html">
              DEPLOY YOUR WORKSTATION <span>↗</span>
            </a>
            <a class="button" href="/ternux/docs/ARCHITECTURE.html">
              EXPLORE THE STACK <span>→</span>
            </a>
          </div>
          <div class="hero-label">
            NO ROOT REQUIRED　/　OPEN SOURCE　/　EVIDENCE LED
          </div>
        </div>
        <div
          class="hero-system-route"
          aria-label="Ternux system route: Android, Termux, a PRoot guest, Termux:X11"
        >
          <span>
            ANDROID <b>HOST</b>
          </span>
          <span>
            TERMUX <b>SHELL</b>
          </span>
          <span>
            PRoot <b>DEBIAN · UBUNTU · ALPINE</b>
          </span>
          <span>
            TERMUX:X11 <b>DISPLAY · AUDIO</b>
          </span>
        </div>
      </div>
    </section>
    <section class="section" id="supported-guests" data-reveal>
      <div class="container">
        <div class="device-panel profile-panel">
          <div class="device-copy">
            <span class="eyebrow">01 / V2 SUPPORTED DESKTOP GUESTS</span>
            <h2>Choose your Linux guest.</h2>
            <p>
              These three profiles are covered by v2 desktop support. Debian is
              the default; twelve more recipes are available but not qualified.
            </p>
          </div>
          <div class="profile-grid">
            <article class="profile-card is-recommended">
              <small>RECOMMENDED DEFAULT</small>
              <strong>Debian</strong>
              <span>Xfce · APT · Avro</span>
            </article>
            <article class="profile-card">
              <small>SUPPORTED GUEST</small>
              <strong>Ubuntu</strong>
              <span>Xfce · APT · snap-safe</span>
            </article>
            <article class="profile-card">
              <small>SUPPORTED GUEST</small>
              <strong>Alpine</strong>
              <span>Xfce · APK · Avro m17n</span>
            </article>
          </div>
        </div>
      </div>
    </section>
    <section class="section" id="system-map" data-reveal>
      <div class="container">
        <header class="section-head">
          <span class="eyebrow">02 / SYSTEM MAP</span>
          <div>
            <h2>
              One device.
              <br />A layered workstation.
            </h2>
            <p>
              Each boundary has a clear job. Ternux assembles the host, Linux
              environment, display and graphics route into one inspectable
              system.
            </p>
          </div>
        </header>
        <div
          class="architecture"
          aria-label="Android to Linux and GPU system flow"
        >
          <article class="arch-stage" data-index="01 / HOST">
            <span class="arch-pulse"></span>
            <h3>Android</h3>
            <p>Phone hardware and kernel</p>
          </article>
          <article class="arch-stage" data-index="02 / SHELL">
            <span class="arch-pulse"></span>
            <h3>Termux</h3>
            <p>Native ARM64 tools</p>
          </article>
          <article class="arch-stage" data-index="03 / LINUX">
            <span class="arch-pulse"></span>
            <h3>PRoot · 15 guest profiles</h3>
            <p>Independent guests · Xfce</p>
          </article>
          <article class="arch-stage" data-index="04 / DISPLAY">
            <span class="arch-pulse"></span>
            <h3>Termux:X11</h3>
            <p>Android X server · tagged guest windows</p>
          </article>
          <article class="arch-stage" data-index="05 / GPU">
            <span class="arch-pulse"></span>
            <h3>VirGL · Zink</h3>
            <p>
              Native distro Mesa · Debian, Ubuntu, and Alpine tested on Adreno
              825
            </p>
          </article>
          <article class="arch-stage" data-index="06 / READY">
            <span class="arch-pulse"></span>
            <h3>Ternux</h3>
            <p>One complete workstation</p>
          </article>
        </div>
        <div class="system-device">
          <WorkstationDiagram lang="en" />
        </div>
      </div>
    </section>
    <section class="section" id="install" data-reveal>
      <div class="container">
        <div class="install-panel">
          <div>
            <span class="eyebrow">03 / FIRST BOOT</span>
            <h2>Bring your Linux workstation online.</h2>
            <p>
              Install Termux from a trusted source, then follow the quick-start
              guide. The setup is explicit, inspectable and designed around the
              phone's real boundaries. The{" "}
              <a href="https://github.com/termux/termux-x11/releases/tag/nightly">
                Termux:X11 shared-UID debug APK
              </a>
              can reduce Android background throttling while the X11 desktop is
              foreground; it requires the GitHub-signed Termux app. F-Droid and
              Google Play users should use the standard universal debug APK from
              the same release page.
            </p>
            <a class="home-section-link" href="/ternux/docs/INSTALLATION.html">
              READ INSTALLATION NOTES ↗
            </a>
            <p>
              Prefer Termux's package manager? Use the signed APT repository for{" "}
              <code>pkg install ternux</code> after its one-time bootstrap.{" "}
              <a href="/ternux/docs/TERMUX-APT.html">APT setup guide ↗</a>
            </p>
          </div>
          <div class="command">
            <small>TERMUX / SHELL</small>
            <button
              type="button"
              data-copy
              data-copy-value="pkg update -y && pkg install -y curl && curl -fsSL https://raw.githubusercontent.com/soobujmiah/ternux/main/install.sh | bash"
            >
              COPY
            </button>
            <code>
              pkg update -y && pkg install -y curl && curl -fsSL
              https://raw.githubusercontent.com/soobujmiah/ternux/main/install.sh
              | bash
            </code>
          </div>
          <div class="command">
            <small>IF YOU PREFER WGET</small>
            <button
              type="button"
              data-copy
              data-copy-value="pkg update -y && pkg install -y wget && wget -qO- https://raw.githubusercontent.com/soobujmiah/ternux/main/install.sh | bash"
            >
              COPY
            </button>
            <code>
              pkg update -y && pkg install -y wget && wget -qO-
              https://raw.githubusercontent.com/soobujmiah/ternux/main/install.sh
              | bash
            </code>
          </div>
        </div>
      </div>
    </section>
    <section
      class="section ecosystem-section"
      id="android-development"
      data-reveal
    >
      <div class="container">
        <div class="ecosystem-panel">
          <div class="ecosystem-graphic" aria-hidden="true">
            <span class="ecosystem-node ecosystem-ternux">
              TERN
              <br />
              UX
            </span>
            <span class="ecosystem-link"></span>
            <span class="ecosystem-node ecosystem-adt">ADT</span>
            <span class="ecosystem-caption">ONE DEVICE · TWO TOOLSETS</span>
          </div>
          <div class="ecosystem-copy">
            <span class="eyebrow">04 / ANDROID DEVELOPMENT</span>
            <h2>Ternux runs Linux. ADT develops Android.</h2>
            <p>
              Ternux v2 supports Debian, Ubuntu and Alpine desktop guests;
              Debian is the recommended default. Twelve more named distro
              recipes are available but not v2-qualified. Ubuntu has its own
              snap-safe setup. ADT adds Android SDK build-tools, platform-tools,
              signing, ADB, Flutter/Dart and native build tools inside the
              guest. ADT's Android development workflow is documented
              separately.
            </p>
            <div class="ecosystem-tags" aria-label="ADT toolchain">
              <span>ANDROID SDK</span>
              <span>ADB</span>
              <span>NDK</span>
              <span>FLUTTER · DART</span>
              <span>CMAKE · NINJA</span>
            </div>
            <a class="button" href="https://github.com/soobujmiah/adt">
              OPEN ADT TOOLCHAIN ↗
            </a>
          </div>
        </div>
      </div>
    </section>
    <section class="section compute-section" id="local-inference" data-reveal>
      <div class="container">
        <header class="section-head">
          <span class="eyebrow">05 / ON-DEVICE INFERENCE</span>
          <div>
            <h2>One model. Three compute paths.</h2>
            <p>
              Compare CPU and Adreno Vulkan measurements from one Android
              reference device. Hexagon HTP appears separately as experimental;
              these results are not performance guarantees for other devices.
            </p>
          </div>
        </header>
        <ComputeBench lang="en" />
      </div>
    </section>
    <section class="section render-section" id="benchmarks" data-reveal>
      <div class="container">
        <header class="section-head">
          <span class="eyebrow">06 / VERIFIED 3D OUTPUT</span>
          <div>
            <h2>From mesh to motion.</h2>
            <p>
              Measured on the Redmi Turbo 4 Pro with Blender 4.3.2, MPFB2 2.0.18
              and EEVEE Next. Each point shows a real output stage.
            </p>
          </div>
        </header>
        <RenderBench lang="en" />
        <div
          class="render-extra-results"
          aria-label="Measured longer animation render results"
        >
          <article>
            <small>27-second animated short</small>
            <strong>648 frames</strong>
            <span>1.126 s per frame mean · EEVEE Next</span>
          </article>
          <article>
            <small>One-minute Bengali short film</small>
            <strong>1,440 frames</strong>
            <span>1.944 s per frame mean · EEVEE Next</span>
          </article>
        </div>
        <p class="notice">
          MPFB2 creates an anatomically correct base mesh. Grooming, finished
          materials, expressive posing and photoreal presentation need further
          work.
        </p>
        <a class="home-section-link" href="/ternux/docs/BENCHMARKS.html">
          OPEN COMPLETE BENCHMARK LOG →
        </a>
      </div>
    </section>
  </main>
</SiteLayout>
